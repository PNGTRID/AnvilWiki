---
/**
 * Landing page 中文版 (/zh/landing) — 项目官网的中文版本。
 * English version lives at /landing.
 *
 * NOTE: this route is intentionally outside the wiki i18n system (locales
 * en/ja are the DEMO GAME's content languages). The landing page speaks for
 * the PROJECT, so it ships its own en/zh pair via src/config/landing.ts.
 */
import LandingLayout from '~/components/landing/LandingLayout.astro';
import LandingHero from '~/components/landing/LandingHero.astro';
import SocialProofBar from '~/components/landing/SocialProofBar.astro';
import FeatureGrid from '~/components/landing/FeatureGrid.astro';
import CompareTable from '~/components/landing/CompareTable.astro';
import Showcase from '~/components/landing/Showcase.astro';
import CommunitySites from '~/components/landing/CommunitySites.astro';
import DocsEntry from '~/components/landing/DocsEntry.astro';
import DevGuide from '~/components/landing/DevGuide.astro';
import FinalCta from '~/components/landing/FinalCta.astro';
import Community from '~/components/landing/Community.astro';
import AdsterraSlot from '~/components/ads/AdsterraSlot.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';

const t = landingContent.zh;
const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/` },
  { hreflang: 'zh', href: `${siteUrl}/zh/landing/` },
];
---

<LandingLayout locale="zh" alternates={alternates}>
  {/* Pagefind body: the marketing sections are searchable site-wide. The
      floating WeChat QR widget stays OUTSIDE the marker so its card copy
      never surfaces as a search result. */}
  <div data-pagefind-body>
    <LandingHero t={t} />
    <SocialProofBar t={t} />
    <FeatureGrid t={t} />
    <AdsterraSlot name="incontent-728x90" width={728} height={90} hideOnMobile />
    <CommunitySites t={t} />
    <CompareTable t={t} />
    <Showcase t={t} />
    <DocsEntry t={t} />
    <DevGuide t={t} />
    <AdsterraSlot name="native-banner" width={700} height={240} />
    <FinalCta t={t} />
  </div>
  <Community t={t} />
</LandingLayout>
