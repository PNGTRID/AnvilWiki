---
/**
 * 对比页中文版 (/zh/landing/comparison) — 「AnvilWiki 对比 Fandom、Wiki.js」。
 * English version lives at /landing/comparison. 独立于 wiki i18n 系统
 * (官网自带 en/zh 一对,见 src/config/landing.ts)。随整个 landing 层
 * 被 apply-template 清理。
 */
import LandingLayout from '~/components/landing/LandingLayout.astro';
import AdsterraSlot from '~/components/ads/AdsterraSlot.astro';
import ComparisonPage from '~/components/landing/ComparisonPage.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';

const t = landingContent.zh;
const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/comparison/` },
  { hreflang: 'zh', href: `${siteUrl}/zh/landing/comparison/` },
];
---

<LandingLayout
  locale="zh"
  alternates={alternates}
  pageTitle={t.comparisonPage.title}
  pageDescription={t.comparisonPage.subtitle}
  togglePath="/landing/comparison/"
>
  <AdsterraSlot name="incontent-728x90" width={728} height={90} hideOnMobile />
  <ComparisonPage t={t} />
  <AdsterraSlot name="native-banner" width={700} height={240} />
</LandingLayout>
