---
/**
 * Tutorials hub 中文版 (/zh/landing/tutorials)。源内容:src/content/tutorials/zh/
 * <slug>.md,slug 与英文版一一对应(hreflang 永远成对真实,parity 由
 * tests/tutorials.test.ts 钉死)。属 landing 层内容,fork 时随整层清理。
 * 页面按「方向」分组渲染:每个 apply-template 站点类型一组(game wiki /
 * 优惠码 / 教程知识库),分组来自 lib/landing-tutorials 的 tutorialsForPreset
 * (TUTORIAL_META 单源),组标题复用 landing `directions` 文案——与官网首页
 * 方向卡逐字同源。与 /landing/tutorials 英文版同构。
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import {
  parseTutorialId,
  tutorialPath,
  tutorialsForLocale,
  tutorialsForPreset,
  type TutorialPreset,
} from '~/lib/landing-tutorials';

const t = landingContent.zh;
const all = await getCollection('tutorials');
const tutorials = tutorialsForLocale(all, 'zh');
const presets: TutorialPreset[] = ['game-wiki', 'coupon-hub', 'tutorial-hub'];

const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/tutorials/` },
  { hreflang: 'zh', href: `${siteUrl}/zh/landing/tutorials/` },
];

// ItemList JSON-LD: hub-and-spoke 信号,与 en hub 同构;保持阅读顺序平铺,
// 与视觉分组无关——一个列表一条阅读路径。
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.tutorials.hubTitle,
    itemListElement: tutorials.map((entry, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: entry.data.title,
      url: `${siteUrl}${tutorialPath('zh', parseTutorialId(entry.id)?.slug ?? '')}`,
    })),
  },
];
---

<LandingLayout
  locale="zh"
  alternates={alternates}
  pageTitle={`${t.tutorials.hubTitle} | AnvilWiki`}
  pageDescription={t.tutorials.hubSubtitle}
  togglePath="/landing/tutorials/"
  extraJsonLd={jsonLd}
>
  <section class="section" data-pagefind-body>
    <div class="mx-auto max-w-5xl">
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        {t.tutorials.hubTitle}
      </h1>
      <p class="mx-auto mt-4 max-w-3xl text-muted-foreground">{t.tutorials.hubSubtitle}</p>

      {
        presets.map((preset) => {
          const copy = t.directions.items[preset];
          const group = tutorialsForPreset(tutorials, preset);
          if (group.length === 0) return null;
          return (
            <div class="mt-12">
              <div class="flex flex-wrap items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-nav/10">
                  <Icon name={copy.icon} class="h-4 w-4 text-nav" />
                </span>
                <h2 class="text-xl font-bold text-foreground">{copy.title}</h2>
                <span class="text-sm text-muted-foreground">{copy.earn}</span>
              </div>
              <div class="mt-5 grid gap-5">
                {group.map((entry) => {
                  const slug = parseTutorialId(entry.id)?.slug ?? '';
                  const updated = entry.data.updated.toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  });
                  return (
                    <a href={tutorialPath('zh', slug)} class="card group flex flex-col p-6">
                      <div class="flex flex-wrap items-center gap-3">
                        <h3 class="text-lg font-bold text-foreground transition group-hover:text-nav">
                          {entry.data.title}
                        </h3>
                        <span class="ml-auto text-xs text-muted-foreground">
                          {t.tutorials.updatedLabel} {updated}
                        </span>
                      </div>
                      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                        {entry.data.description}
                      </p>
                      {entry.data.tldr && (
                        <p class="mt-3 border-l-2 border-nav/40 pl-3 text-sm leading-relaxed text-foreground/80">
                          {entry.data.tldr}
                        </p>
                      )}
                      <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-nav">
                        <span class="border-b border-transparent transition group-hover:border-nav">
                          {t.tutorials.readLabel}
                        </span>
                        <Icon name="lucide:arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5" />
                      </span>
                    </a>
                  );
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</LandingLayout>
