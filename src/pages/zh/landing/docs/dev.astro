---
/**
 * 开发手册目录页 (/zh/landing/docs/dev)。English: /landing/docs/dev。
 */
import { getCollection } from 'astro:content';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import HandbookManualList from '~/components/landing/HandbookManualList.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import { chaptersForLocale } from '~/lib/handbook';

const t = landingContent.zh;
const chapters = chaptersForLocale(await getCollection('handbook'), 'zh');

const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/docs/dev` },
  { hreflang: 'zh', href: `${siteUrl}/zh/landing/docs/dev` },
];
---

<LandingLayout
  locale="zh"
  alternates={alternates}
  pageTitle={`${t.handbook.manuals.dev.label} | AnvilWiki 文档`}
  pageDescription={t.handbook.manuals.dev.description}
  togglePath="/landing/docs/dev"
  search
>
  <HandbookManualList manual="dev" chapters={chapters} locale="zh" t={t} />
</LandingLayout>
