---
/**
 * 文档中心中文版 (/zh/landing/docs)。章节源:docs/handbook/zh/*.md
 * (与 en 同 slug,parity 由 tests/handbook.test.ts 把关)。English: /landing/docs。
 */
import { getCollection } from 'astro:content';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import HandbookHub from '~/components/landing/HandbookHub.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import { chaptersForLocale, handbookPath, parseHandbookId } from '~/lib/handbook';

const t = landingContent.zh;
const all = await getCollection('handbook');
const chapters = chaptersForLocale(all, 'zh');

const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/docs` },
  { hreflang: 'zh', href: `${siteUrl}/zh/landing/docs` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.handbook.hubTitle,
    itemListElement: chapters.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.data.title,
      url: `${siteUrl}${handbookPath('zh', parseHandbookId(c.id)?.slug ?? '')}`,
    })),
  },
];
---

<LandingLayout
  locale="zh"
  alternates={alternates}
  pageTitle={`${t.handbook.hubTitle} | AnvilWiki`}
  pageDescription={t.handbook.hubSubtitle}
  togglePath="/landing/docs"
  search
  extraJsonLd={jsonLd}
>
  <HandbookHub chapters={chapters} locale="zh" t={t} />
</LandingLayout>
