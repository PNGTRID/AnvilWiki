---
/**
 * 手册章节中文路由 (/zh/landing/docs/<slug>)。源:docs/handbook/zh/<slug>.md,
 * slug 与英文版一一对应(hreflang 永远成对真实)。
 */
import { getCollection, render } from 'astro:content';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import HandbookChapter from '~/components/landing/HandbookChapter.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import { chaptersForLocale, handbookPath, parseHandbookId, prevNext } from '~/lib/handbook';

export async function getStaticPaths() {
  // Dynamic import: getStaticPaths compiles to its own module (AGENTS.md gotcha #3).
  const { getCollection: gc } = await import('astro:content');
  const all = await gc('handbook');
  return all
    .map((entry) => ({ entry, parsed: parseHandbookId(entry.id) }))
    .filter((x) => x.parsed?.locale === 'zh')
    .map((x) => ({ params: { slug: x.parsed!.slug }, props: { entry: x.entry } }));
}

const { entry } = Astro.props;
const slug = Astro.params.slug ?? parseHandbookId(entry.id)?.slug ?? '';
const { Content, headings } = await render(entry);

const t = landingContent.zh;
const all = await getCollection('handbook');
const chapters = chaptersForLocale(all, 'zh');
const { prev, next } = prevNext(chapters, entry.id);
const chapterPath = handbookPath('zh', slug);

const alternates = [
  { hreflang: 'en', href: `${siteUrl}${handbookPath('en', slug)}` },
  { hreflang: 'zh', href: `${siteUrl}${chapterPath}` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t.handbook.hubTitle,
        item: `${siteUrl}${handbookPath('zh', '', true)}`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t.handbook.manuals[entry.data.manual].label,
        item: `${siteUrl}${handbookPath('zh', '', true)}`,
      },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: `${siteUrl}${chapterPath}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: entry.data.title,
    description: entry.data.description,
    // 与 en 版一致：缺 `updated` 的章节省略日期，不用构建时间伪造新鲜度。
    ...(entry.data.updated
      ? {
          datePublished: entry.data.updated.toISOString(),
          dateModified: entry.data.updated.toISOString(),
        }
      : {}),
    author: { '@type': 'Organization', name: 'AnvilWiki' },
    isAccessibleForFree: true,
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}${chapterPath}` },
  },
];
---

<LandingLayout
  locale="zh"
  alternates={alternates}
  pageTitle={`${entry.data.title} | AnvilWiki 文档`}
  pageDescription={entry.data.description}
  togglePath={handbookPath('en', slug)}
  extraJsonLd={jsonLd}
  search
>
  <HandbookChapter
    locale="zh"
    chapter={entry}
    t={t}
    chapters={chapters}
    headings={headings}
    prev={prev}
    next={next}
  >
    <Content />
  </HandbookChapter>
</LandingLayout>
