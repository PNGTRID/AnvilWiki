---
/**
 * Landing page (/landing, English) — the tutorials-first face of AnvilWiki.
 * NOT the demo game site (that's at /). 中文版在 /zh/landing。
 *
 * De-clutter batch (2026-11-02): 12 sections → 7. The page serves LEARNERS
 * (hero + directions + author); the template pitch compresses into ONE
 * bridge section. Deep-dive pitch content lives on its own pages:
 * /landing/comparison (full table), /landing/docs (handbooks). Parked
 * components (SocialProofBar / FeatureGrid / CompareTable / Showcase /
 * DocsEntry / DevGuide) stay in src/components/landing/ — unused by any
 * page, tree-shaken from the build, kept for easy reinstatement.
 *
 * Sections (top to bottom):
 *   1. Hero (tutorials-first narrative + CTAs + install command)
 *   2. DirectionCards ("pick a direction" — one card per site-type preset)
 *   3. AuthorCard (who builds AnvilWiki — trust right after directions)
 *   4. TemplateBridge (compact template pitch + proof chips + fork/comparison)
 *   5. CommunitySites (real community-built sites — social proof)
 *   6. FinalCta (Community is a floating WeChat QR pill, bottom-right)
 */
import { getCollection } from 'astro:content';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import LandingHero from '~/components/landing/LandingHero.astro';
import DirectionCards from '~/components/landing/DirectionCards.astro';
import AuthorCard from '~/components/landing/AuthorCard.astro';
import TemplateBridge from '~/components/landing/TemplateBridge.astro';
import CommunitySites from '~/components/landing/CommunitySites.astro';
import FinalCta from '~/components/landing/FinalCta.astro';
import Community from '~/components/landing/Community.astro';
import AdsterraSlotPair from '~/components/ads/AdsterraSlotPair.astro';
import AdsterraSlot from '~/components/ads/AdsterraSlot.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import { tutorialsForLocale } from '~/lib/landing-tutorials';

const t = landingContent.en;
const tutorials = tutorialsForLocale(await getCollection('tutorials'), 'en');
const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/` },
  { hreflang: 'zh', href: `${siteUrl}/zh/landing/` },
];
---

<LandingLayout locale="en" alternates={alternates}>
  {/* Pagefind body: the marketing sections are searchable site-wide. The
      floating WeChat QR widget stays OUTSIDE the marker so its card copy
      never surfaces as a search result. */}
  <div data-pagefind-body>
    {/* Top-of-content native banner — compact 700×240 slot (renders ~218px
        tall), the smaller sibling of the full-width reference mount. Width
        is load-bearing: narrower iframes flip the responsive script to a
        taller vertical card stack. */}
    <AdsterraSlot name="native-banner" width={700} height={240} />
    <LandingHero t={t} />
    <DirectionCards t={t} locale="en" tutorials={tutorials} />
    <AuthorCard t={t} />
    {/* Adsterra pair: 728×90 after the bridge (mid-page), responsive native
        after CommunitySites; FinalCta keeps its position after the native
        unit via the pair's `after` slot. */}
    <AdsterraSlotPair>
      <TemplateBridge t={t} />
      <CommunitySites t={t} />
      <Fragment slot="after">
        <FinalCta t={t} />
      </Fragment>
    </AdsterraSlotPair>
  </div>
  <Community t={t} />
</LandingLayout>
