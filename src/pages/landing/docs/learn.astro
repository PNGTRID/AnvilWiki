---
/**
 * Learning Manual index (/landing/docs/learn, English) — the manual's own
 * page with a numbered chapter list. 中文版在 /zh/landing/docs/learn。
 */
import { getCollection } from 'astro:content';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import HandbookManualList from '~/components/landing/HandbookManualList.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import { chaptersForLocale } from '~/lib/handbook';

const t = landingContent.en;
const chapters = chaptersForLocale(await getCollection('handbook'), 'en');

const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/docs/learn` },
  { hreflang: 'zh', href: `${siteUrl}/zh/landing/docs/learn` },
];
---

<LandingLayout
  locale="en"
  alternates={alternates}
  pageTitle={`${t.handbook.manuals.learn.label} | AnvilWiki Docs`}
  pageDescription={t.handbook.manuals.learn.description}
  togglePath="/zh/landing/docs/learn"
  search
>
  <HandbookManualList manual="learn" chapters={chapters} locale="en" t={t} />
</LandingLayout>
