---
/**
 * Docs hub (/landing/docs, English) — the in-site documentation center.
 * Lists both handbook manuals (learn + dev) as chapter cards. Chapter source
 * lives in docs/handbook/<locale>/*.md (single source of truth, also on
 * GitHub). 中文版在 /zh/landing/docs。
 */
import { getCollection } from 'astro:content';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import HandbookHub from '~/components/landing/HandbookHub.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import { chaptersForLocale, handbookPath, parseHandbookId } from '~/lib/handbook';

const t = landingContent.en;
const all = await getCollection('handbook');
const chapters = chaptersForLocale(all, 'en');

const alternates = [
  { hreflang: 'en', href: `${siteUrl}/landing/docs` },
  { hreflang: 'zh', href: `${siteUrl}/zh/landing/docs` },
];

// ItemList JSON-LD: hub-and-spoke signal for the chapter structure.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.handbook.hubTitle,
    itemListElement: chapters.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.data.title,
      url: `${siteUrl}${handbookPath('en', parseHandbookId(c.id)?.slug ?? '')}`,
    })),
  },
];
---

<LandingLayout
  locale="en"
  alternates={alternates}
  pageTitle={`${t.handbook.hubTitle} | AnvilWiki`}
  pageDescription={t.handbook.hubSubtitle}
  togglePath="/zh/landing/docs"
  search
  extraJsonLd={jsonLd}
>
  <HandbookHub chapters={chapters} locale="en" t={t} />
</LandingLayout>
