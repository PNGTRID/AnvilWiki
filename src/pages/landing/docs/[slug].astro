---
/**
 * Handbook chapter route (/landing/docs/<slug>, English). Source markdown:
 * docs/handbook/en/<slug>.md. zh twin lives at /zh/landing/docs/<slug>
 * (same slug — hreflang pairs are always real; parity is enforced by
 * tests/handbook.test.ts).
 */
import { getCollection, render } from 'astro:content';
import LandingLayout from '~/components/landing/LandingLayout.astro';
import HandbookChapter from '~/components/landing/HandbookChapter.astro';
import { landingContent } from '~/config/landing';
import { siteUrl } from '~/config/site';
import {
  chaptersForLocale,
  handbookPath,
  parseHandbookId,
  prevNext,
} from '~/lib/handbook';

export async function getStaticPaths() {
  // Dynamic import: getStaticPaths compiles to its own module (AGENTS.md gotcha #3).
  const { getCollection: gc } = await import('astro:content');
  const all = await gc('handbook');
  return all
    .map((entry) => ({ entry, parsed: parseHandbookId(entry.id) }))
    .filter((x) => x.parsed?.locale === 'en')
    .map((x) => ({ params: { slug: x.parsed!.slug }, props: { entry: x.entry } }));
}

const { entry } = Astro.props;
const slug = Astro.params.slug ?? parseHandbookId(entry.id)?.slug ?? '';
const { Content, headings } = await render(entry);

const t = landingContent.en;
const all = await getCollection('handbook');
const chapters = chaptersForLocale(all, 'en');
const { prev, next } = prevNext(chapters, entry.id);
const chapterPath = handbookPath('en', slug);

const alternates = [
  { hreflang: 'en', href: `${siteUrl}${chapterPath}` },
  { hreflang: 'zh', href: `${siteUrl}${handbookPath('zh', slug)}` },
];

// Breadcrumb (hub → manual → chapter) + TechArticle for docs content.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t.handbook.hubTitle,
        item: `${siteUrl}${handbookPath('en', '', true)}`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t.handbook.manuals[entry.data.manual].label,
        item: `${siteUrl}${handbookPath('en', '', true)}`,
      },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: `${siteUrl}${chapterPath}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: entry.data.title,
    description: entry.data.description,
    // Fabricating dates from build time feeds Google a bogus freshness signal
    // that changes on every build — chapters without `updated` omit the dates.
    ...(entry.data.updated
      ? {
          datePublished: entry.data.updated.toISOString(),
          dateModified: entry.data.updated.toISOString(),
        }
      : {}),
    author: { '@type': 'Organization', name: 'AnvilWiki' },
    isAccessibleForFree: true,
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}${chapterPath}` },
  },
];
---

<LandingLayout
  locale="en"
  alternates={alternates}
  pageTitle={`${entry.data.title} | AnvilWiki Docs`}
  pageDescription={entry.data.description}
  togglePath={handbookPath('zh', slug)}
  extraJsonLd={jsonLd}
  search
>
  <HandbookChapter
    locale="en"
    chapter={entry}
    t={t}
    chapters={chapters}
    headings={headings}
    prev={prev}
    next={next}
  >
    <Content />
  </HandbookChapter>
</LandingLayout>
