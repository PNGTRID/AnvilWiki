---
/**
 * Code-cards displayType — shows redeemable codes with detail and badge.
 * Used for the "Codes" module on the homepage.
 */
interface Props {
  highlights: Array<{ label: string; detail: string; badge?: string }>;
}
const { highlights } = Astro.props;
---

<div class="space-y-2">
  {
    highlights.map((h) => (
      <div class="flex items-center justify-between rounded-md border bg-card p-3">
        <div class="min-w-0 flex-1">
          <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs font-semibold text-nav">
            {h.label}
          </code>
          <p class="mt-1 text-xs text-muted-foreground">{h.detail}</p>
        </div>
        {h.badge && (
          <span
            class:list={[
              'ml-2 shrink-0 rounded-full px-2 py-0.5 text-[10px] font-medium',
              h.badge.toLowerCase().includes('expire')
                ? 'bg-red-500/15 text-red-600 dark:text-red-400'
                : 'bg-green-500/15 text-green-600 dark:text-green-400',
            ]}
          >
            {h.badge}
          </span>
        )}
      </div>
    ))
  }
</div>
