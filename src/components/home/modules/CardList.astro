---
/**
 * Card-list displayType — simple labeled cards.
 * Used for boss lists, item categories, class builds, etc.
 *
 * Note: per PRD, the `label` must be de-emojified (short English text),
 * because this component renders label as-is. Never put emoji in label.
 */
interface Props {
  highlights: Array<{ label: string; detail: string }>;
}
const { highlights } = Astro.props;
---
<div class="grid gap-2 sm:grid-cols-2">
  {highlights.map((h) => (
    <div class="rounded-md border bg-card p-3">
      <p class="text-sm font-semibold text-foreground">{h.label}</p>
      <p class="mt-0.5 text-xs text-muted-foreground">{h.detail}</p>
    </div>
  ))}
</div>
