---
/**
 * ExploreModules — renders the homepage content modules.
 *
 * Each module specifies a `displayType` that controls how its `highlights`
 * are rendered. We dispatch to the corresponding sub-component.
 *
 * Supported displayTypes (per PRD §6.5):
 *   - code-cards   → CodeCards (redeemable codes with badge)
 *   - step-by-step → StepByStep (numbered progression steps)
 *   - tier-grid    → TierGrid (S/A/B/C ranked items)
 *   - card-list    → CardList (simple labeled cards)
 *
 * v0.2: each module card is now a single clickable <a> (block-level) with
 * hover border feedback, replacing the cramped "View" link that sat on the
 * same line as the title. The whole tile navigates; an arrow in the footer
 * signals affordance.
 */
import { Icon } from 'astro-icon/components';
import CodeCards from './modules/CodeCards.astro';
import StepByStep from './modules/StepByStep.astro';
import TierGrid from './modules/TierGrid.astro';
import CardList from './modules/CardList.astro';
import { type Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';

interface Props {
  modules: Array<{
    order: number;
    name: string;
    description: string;
    href: string;
    displayType: string;
    highlights: Array<{ label: string; detail: string; badge?: string }>;
  }>;
  locale: Locale;
}
const { modules, locale } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-2">
  {
    modules.map((m) => (
      <a href={localizePath(m.href, locale)} class="card group block overflow-hidden p-5">
        <h3 class="text-lg font-bold leading-snug">{m.name}</h3>
        <p class="mt-1 text-sm text-muted-foreground">{m.description}</p>

        <div class="mt-4">
          {m.displayType === 'code-cards' && <CodeCards highlights={m.highlights} />}
          {m.displayType === 'step-by-step' && <StepByStep highlights={m.highlights} />}
          {m.displayType === 'tier-grid' && <TierGrid highlights={m.highlights} />}
          {m.displayType === 'card-list' && <CardList highlights={m.highlights} />}
        </div>

        <p class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-nav">
          <span class="border-b border-transparent transition group-hover:border-nav">View all</span>
          <Icon
            name="lucide:arrow-right"
            class="h-3 w-3 transition group-hover:translate-x-0.5"
          />
        </p>
      </a>
    ))
  }
</div>
