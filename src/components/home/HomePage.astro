---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero        — title, description, stats, CTAs
 *   2. Recent Updates + StartHere (two columns)
 *   3. AboutGame   — game intro + stat cards
 *   4. Explore     — 8 content modules with 4 displayTypes
 *   5. FAQ         — native <details> accordion
 *   6. FinalCta    — bottom call-to-action
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import TrendingNow from '~/components/home/TrendingNow.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { localizePath, listPath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
}
const { locale, jsonLd = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home as any;
const shared = ui.shared as Record<string, string>;

const recent = await getRecentEntries(locale, 6);

const meta = home.meta ?? { title: site.name, description: site.description };
const hero = home.hero ?? {};
const updates = home.updates ?? { title: 'Recent Updates' };
const start = home.start ?? { cards: [] };
const popular = home.popular ?? { title: 'Trending Now', quickLinks: [] };
const aboutGame = home.aboutGame ?? {};
const explore = home.explore ?? { modules: [] };
const faq = home.faq ?? { items: [] };
const finalCta = home.finalCta ?? {};
---

<LocaleLayout locale={locale} title={meta.title} description={meta.description} jsonLd={jsonLd}>
  {/* Hero */}
  <section class="relative overflow-hidden border-b border-border">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-wider text-nav">{hero.eyebrow}</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight md:text-6xl">{hero.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted-foreground">{hero.description}</p>
      {
        hero.stats && (
          <dl class="mt-8 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4">
            {hero.stats.map((stat: string) => (
              <div class="rounded-lg border bg-card p-3 text-center">
                <dd class="text-xs font-semibold text-foreground sm:text-sm">{stat}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="mt-8 flex flex-wrap gap-3">
        {
          hero.primaryCta && (
            <a
              href={site.social.official}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              <Icon name="lucide:play" class="mr-2 h-4 w-4" />
              {hero.primaryCta}
            </a>
          )
        }
        {
          hero.secondaryCta && (
            <a href={listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale)} class="btn-outline">
              {hero.secondaryCta}
            </a>
          )
        }
        {
          hero.tertiaryCta && (
            <a href={listPath('codes', locale)} class="btn-outline">
              <Icon name="lucide:gift" class="mr-2 h-4 w-4" />
              {hero.tertiaryCta}
            </a>
          )
        }
      </div>
    </div>
  </section>

  {/* Video (immediately after Hero) */}
  <VideoSection videoId={hero.videoId} title={`${site.game.name} trailer`} />

  {/* Recent Updates + Start Here */}
  <section class="mx-auto max-w-7xl px-4 py-12">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold">{updates.title}</h2>
          <a href={listPath('guides', locale)} class="text-sm text-nav hover:underline"
            >{shared.browseAll}</a
          >
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            recent.length === 0 ? (
              <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
            ) : (
              recent.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="card p-4">
                    <p class="text-xs uppercase tracking-wider text-muted-foreground">
                      {parsed.category}
                    </p>
                    <h3 class="mt-1 font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </a>
                );
              })
            )
          }
        </div>
      </div>

      {/* Start Here cards */}
      {
        start.cards?.length > 0 && (
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-nav">{start.eyebrow}</p>
            <h2 class="mt-1 text-2xl font-bold">{start.title}</h2>
            <ul class="mt-4 space-y-2">
              {start.cards.map((card: any) => (
                <li class="flex items-start gap-3 rounded-md border bg-card p-3">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-nav text-xs font-bold text-white">
                    {card.number}
                  </span>
                  <div>
                    <p class="text-sm font-semibold">{card.title}</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">{card.description}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {/* Trending Now */}
  <TrendingNow
    locale={locale}
    eyebrow={popular.eyebrow}
    title={popular.title}
    quickLinks={popular.quickLinks}
  />

  {/* About Game */}
  {
    aboutGame.title && (
      <section class="mx-auto max-w-7xl px-4 py-12">
        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <h2 class="text-2xl font-bold">{aboutGame.title}</h2>
            {(aboutGame.paragraphs ?? []).map((p: string) => (
              <p class="mt-3 text-muted-foreground">{p}</p>
            ))}
            {aboutGame.cta && (
              <a href={listPath('guides', locale)} class="btn-outline mt-4">
                {aboutGame.cta}
                <Icon name="lucide:arrow-right" class="ml-2 h-4 w-4" />
              </a>
            )}
          </div>
          {aboutGame.stats?.length > 0 && (
            <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              {aboutGame.stats.map((s: { label: string; value: string }) => (
                <div class="rounded-lg border bg-card p-4 text-center">
                  <dt class="text-xs uppercase tracking-wider text-muted-foreground">{s.label}</dt>
                  <dd class="mt-1 text-lg font-bold text-nav">{s.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </section>
    )
  }

  {/* Explore — 8 modules with displayTypes */}
  {
    explore.modules?.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-12">
        <h2 class="text-2xl font-bold">{explore.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{explore.description}</p>
        <div class="mt-6">
          <ExploreModules modules={explore.modules} locale={locale} />
        </div>
      </section>
    )
  }

  {/* FAQ */}
  {
    faq.items?.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-12">
        <h2 class="text-2xl font-bold">{faq.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{faq.description}</p>
        <div class="mt-6 space-y-2" data-faq-group>
          {faq.items.map((item: any) => (
            <details class="group rounded-md border bg-card">
              <summary
                class="flex cursor-pointer list-none items-center justify-between p-4 font-medium"
                aria-expanded="false"
              >
                {item.question}
                <Icon name="lucide:chevron-down" class="h-4 w-4 transition group-open:rotate-180" />
              </summary>
              <div class="px-4 pb-4 text-sm text-muted-foreground">{item.answer}</div>
            </details>
          ))}
        </div>
      </section>
    )
  }

  {/* Final CTA */}
  {
    finalCta.title && (
      <section class="mx-auto max-w-7xl px-4 py-12">
        <div class="rounded-xl border bg-card p-8 text-center">
          <h2 class="text-2xl font-bold">{finalCta.title}</h2>
          <p class="mt-2 text-muted-foreground">{finalCta.description}</p>
          <div class="mt-6 flex justify-center gap-3">
            <a
              href={site.social.official}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              {finalCta.primary}
            </a>
            {finalCta.secondary && site.social.discord && (
              <a
                href={site.social.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline"
              >
                {finalCta.secondary}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>
<script is:inline>
  // Sync aria-expanded on FAQ summaries when details toggle.
  document.querySelectorAll('[data-faq-group] details').forEach((d) => {
    const sync = () => d.querySelector('summary')?.setAttribute('aria-expanded', d.open ? 'true' : 'false');
    sync();
    d.addEventListener('toggle', sync);
  });
</script>
