---
/**
 * VideoSection — embeds a YouTube trailer/gameplay video right below the Hero.
 *
 * Per design: the video module must sit immediately after the Hero region.
 * The video ID comes from the locale JSON `home.hero.videoId`.
 *
 * Uses lite-youtube-embed-style lazy loading: the iframe is only inserted
 * on click, saving ~500KB of YouTube JS on initial paint. Pure vanilla JS,
 * no framework runtime.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** YouTube video ID (from home.hero.videoId). */
  videoId?: string;
  /** Title for accessibility + the play button overlay. */
  title?: string;
}
const { videoId, title = 'Watch trailer' } = Astro.props;
---
{videoId && (
  <section class="border-b border-border">
    <div class="mx-auto max-w-4xl px-4 py-8">
      <div
        id={`yt-${videoId}`}
        data-id={videoId}
        class="relative aspect-video w-full cursor-pointer overflow-hidden rounded-lg bg-black"
        role="button"
        aria-label={`Play video: ${title}`}
      >
        {/* Thumbnail (lazy, no YouTube JS loaded yet) */}
        <img
          src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
          alt={title}
          class="h-full w-full object-cover opacity-80 transition group-hover:opacity-100"
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
        />
        {/* Play button overlay */}
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600 shadow-lg transition hover:scale-110 hover:bg-red-500">
            <Icon name="lucide:play" class="ml-1 h-7 w-7 text-white" />
          </span>
        </div>
      </div>
    </div>
  </section>
)}
<script is:inline>
  // Lazy-load YouTube iframe on click (saves ~500KB on initial paint).
  document.querySelectorAll('[data-id]').forEach((el) => {
    const id = el.getAttribute('data-id');
    if (!id) return;
    el.addEventListener('click', function handler() {
      el.removeEventListener('click', handler);
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = el.getAttribute('aria-label') || 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
      el.innerHTML = '';
      el.appendChild(iframe);
    });
  });
</script>
