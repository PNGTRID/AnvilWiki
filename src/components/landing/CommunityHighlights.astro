---
/**
 * CommunityHighlights — the standalone "社群精华" page (/landing/community +
 * /zh/landing/community). Three-column wide layout: left sidebar = section
 * nav, middle = one big card per category with item cards inside, right
 * sidebar = sticky daily-digest timeline. Renders the AI-curated WeChat
 * group digest from community-digest.json (refreshed daily by an automation
 * pipeline; this file never needs manual edits). Section labels live in
 * landing.ts (`communityHighlights`); item content is Chinese source data
 * shown as-is on both locales. apply-template removes the whole landing
 * layer, so forks never inherit the digest.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';
import digest from './community-digest.json';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
const c = t.communityHighlights;

interface DigestItem {
  date: string;
  title?: string;
  detail?: string;
  q?: string;
  a?: string;
  tags?: string[];
  attrib?: string;
  status?: string;
}
interface CommunityDigest {
  schemaVersion: number;
  updated: string;
  since: string;
  categories: { id: string; items: DigestItem[] }[];
  daily: { date: string; summary: string; topics: string[] }[];
}
const data = digest as CommunityDigest;

const byId = new Map(data.categories.map((cat) => [cat.id, cat.items]));
const SECTION_META = [
  { id: 'gold', icon: 'lucide:gem' },
  { id: 'pitfalls', icon: 'lucide:triangle-alert' },
  { id: 'qa', icon: 'lucide:messages-square' },
  { id: 'feedback', icon: 'lucide:megaphone' },
  { id: 'news', icon: 'lucide:rocket' },
] as const;
type SectionId = (typeof SECTION_META)[number]['id'];
const visible = SECTION_META.map((s) => ({ ...s, items: byId.get(s.id) ?? [] })).filter(
  (s) => s.items.length > 0,
);
---

<section class="section">
  <!-- Full-width page header -->
  <div class="mx-auto max-w-7xl">
    <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">{c.title}</h1>
    <p class="mt-3 max-w-3xl text-lg text-muted-foreground">{c.subtitle}</p>
    <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:calendar-check" class="h-4 w-4 shrink-0 text-nav" />
        {c.updatedLabel}: {data.updated}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:history" class="h-4 w-4 shrink-0 text-nav" />
        {c.sinceLabel}: {data.since}
      </span>
    </p>
    <p
      class="mt-3 flex max-w-3xl items-start gap-2 rounded-lg border border-border bg-muted/30 p-3 text-xs leading-relaxed text-muted-foreground"
    >
      <Icon name="lucide:info" class="mt-0.5 h-4 w-4 shrink-0 text-nav" />
      {c.disclaimer}
    </p>
  </div>

  <!-- Three columns: section nav / big cards / daily digest -->
  <div class="mx-auto mt-10 grid max-w-7xl gap-8 lg:grid-cols-[200px_minmax(0,1fr)_300px]">
    <!-- Left: section nav (desktop) -->
    <aside class="hidden lg:block">
      <nav class="sticky top-20" aria-label={c.tocLabel}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          {c.tocLabel}
        </p>
        <ul class="mt-3 space-y-1">
          {
            visible.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-muted-foreground transition hover:bg-muted hover:text-foreground"
                >
                  <Icon name={s.icon} class="h-4 w-4 shrink-0 text-nav" />
                  <span class="truncate">{c.sections[s.id].title}</span>
                  <span class="ml-auto text-xs text-muted-foreground/70">{s.items.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <!-- Middle: one big card per category -->
    <div class="min-w-0 space-y-6">
      {
        visible.map((s) => {
          const meta = c.sections[s.id];
          const twoCol = s.id === 'gold' || s.id === 'pitfalls' || s.id === 'qa';
          return (
            <section id={s.id} class="scroll-mt-24 rounded-xl border border-border bg-card p-5">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h2 class="flex items-center gap-2 text-xl font-bold tracking-tight text-foreground">
                  <Icon name={s.icon} class="h-5 w-5 shrink-0 text-nav" />
                  {meta.title}
                </h2>
                <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">
                  {s.items.length}
                </span>
                <span class="text-sm text-muted-foreground">{meta.hint}</span>
              </div>
              <div class:list={['mt-4 grid gap-3', twoCol && 'md:grid-cols-2']}>
                {s.items.map((item) => (
                  <article class="rounded-lg border border-border bg-muted/30 p-4">
                    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                      <span class="rounded bg-nav/10 px-1.5 py-0.5 text-xs font-semibold text-nav">
                        {item.date}
                      </span>
                      <h3 class="font-semibold text-foreground">{item.q ?? item.title}</h3>
                      {item.attrib && (
                        <span class="text-xs text-muted-foreground">— {item.attrib}</span>
                      )}
                      {item.status === 'open' && (
                        <span class="rounded-full border border-nav/30 px-2 py-0.5 text-xs font-medium text-nav">
                          {c.openLabel}
                        </span>
                      )}
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                      {item.a ?? item.detail}
                    </p>
                    {item.tags && item.tags.length > 0 && (
                      <div class="mt-2 flex flex-wrap gap-1.5">
                        {item.tags.map((tag) => (
                          <span class="rounded-full border border-border px-2 py-0.5 text-xs text-muted-foreground">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </section>
          );
        })
      }

      <!-- CTA -->
      <div class="rounded-xl border border-border bg-nav/5 p-8 text-center">
        <h2 class="text-2xl font-extrabold tracking-tight text-foreground">{c.cta.title}</h2>
        <p class="mt-2 text-muted-foreground">{c.cta.subtitle}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href={c.cta.primaryHref} class="btn-primary inline-flex items-center gap-1.5">
            <Icon name="lucide:external-link" class="h-4 w-4" />
            {c.cta.primaryLabel}
          </a>
          <a href={c.cta.secondaryHref} class="btn-outline inline-flex items-center gap-1.5">
            {c.cta.secondaryLabel}
          </a>
        </div>
      </div>
    </div>

    <!-- Right: daily digest, sticky with its own scroll on desktop -->
    <aside>
      <div class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
        <div class="rounded-xl border border-border bg-card p-5">
          <h2 class="flex items-center gap-2 text-lg font-bold tracking-tight text-foreground">
            <Icon name="lucide:calendar-days" class="h-5 w-5 shrink-0 text-nav" />
            {c.sections.daily.title}
          </h2>
          <p class="mt-1 text-xs text-muted-foreground">{c.sections.daily.hint}</p>
          <ol class="mt-4 space-y-4 border-l border-border pl-4">
            {
              data.daily.map((day) => (
                <li class="relative">
                  <span class="absolute -left-[22px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-background bg-nav" />
                  <p class="text-sm leading-relaxed">
                    <span class="font-semibold text-foreground">{day.date}</span>
                    <span class="text-muted-foreground"> — {day.summary}</span>
                  </p>
                  <div class="mt-1.5 flex flex-wrap gap-1">
                    {day.topics.map((topic) => (
                      <span class="rounded-full bg-muted px-1.5 py-0.5 text-[11px] text-muted-foreground">
                        {topic}
                      </span>
                    ))}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </aside>
  </div>
</section>
