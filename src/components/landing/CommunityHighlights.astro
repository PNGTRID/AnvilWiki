---
/**
 * CommunityHighlights — the standalone "社群精华" page (/landing/community +
 * /zh/landing/community), ultra-wide layout (v3, expert-panel redesign):
 *
 *   [header: title+meta | stats chips + disclaimer]
 *   [full-bleed horizontal daily-digest band — the freshness signal]
 *   [main: left sticky TOC (scroll-spy) | chapter sections, per-category
 *    density (gold heavy cards / pitfalls accent cards / qa rows /
 *    feedback open-highlight cards / news compact timeline) + CTA]
 *
 * Container steps 1600px → 1728px (2xl); wider viewports gain columns via
 * auto-fill grids, never longer lines (Chinese comfort ≈ 30-40 chars/row).
 * Renders the AI-curated WeChat digest from community-digest.json (daily
 * automation PR; this file needs no manual edits). Labels live in
 * landing.ts (`communityHighlights`); item content is Chinese source data
 * shown as-is on both locales. apply-template removes the whole landing
 * layer, so forks never inherit the digest.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';
import digest from './community-digest.json';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
const c = t.communityHighlights;

interface DigestItem {
  date: string;
  title?: string;
  detail?: string;
  q?: string;
  a?: string;
  tags?: string[];
  attrib?: string;
  status?: string;
}
interface CommunityDigest {
  schemaVersion: number;
  updated: string;
  since: string;
  categories: { id: string; items: DigestItem[] }[];
  daily: { date: string; summary: string; topics: string[] }[];
}
const data = digest as CommunityDigest;

const byId = new Map(data.categories.map((cat) => [cat.id, cat.items]));
const SECTION_META = [
  { id: 'gold', icon: 'lucide:gem' },
  { id: 'pitfalls', icon: 'lucide:triangle-alert' },
  { id: 'qa', icon: 'lucide:messages-square' },
  { id: 'feedback', icon: 'lucide:megaphone' },
  { id: 'news', icon: 'lucide:rocket' },
] as const;
type SectionId = (typeof SECTION_META)[number]['id'];
const visible = SECTION_META.map((s) => ({ ...s, items: byId.get(s.id) ?? [] })).filter(
  (s) => s.items.length > 0,
);

/** Ultra-wide stepped container — mirrors LandingLayout's `wide` header/footer. */
const WRAP = 'mx-auto w-full max-w-[1600px] px-4 sm:px-6 lg:px-8 2xl:max-w-[1728px] 2xl:px-10';
const dateBadge = 'rounded bg-nav/10 px-1.5 py-0.5 font-mono text-[11px] font-semibold tabular-nums text-nav';
const tagChip = 'rounded bg-muted px-1.5 py-0.5 text-[11px] text-muted-foreground';
---

<section class="py-12 md:py-16">
  <!-- A. Page header — two-column on xl: value copy left, stats + disclaimer right -->
  <div class:list={[WRAP]}>
    <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_400px] xl:items-start xl:gap-10">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
          {c.title}
        </h1>
        <p class="mt-3 max-w-3xl text-lg text-muted-foreground">{c.subtitle}</p>
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:calendar-check" class="h-4 w-4 shrink-0 text-nav" />
            {c.updatedLabel}: {data.updated}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:history" class="h-4 w-4 shrink-0 text-nav" />
            {c.sinceLabel}: {data.since}
          </span>
        </p>
      </div>
      <div class="mt-6 xl:mt-0">
        <div class="grid grid-cols-3 gap-2">
          {
            visible.map((s) => (
              <a
                href={`#${s.id}`}
                class="rounded-lg border border-border bg-card px-3 py-2 text-center transition hover:border-nav/40"
              >
                <span class="block text-lg font-bold tabular-nums text-foreground">
                  {s.items.length}
                </span>
                <span class="block truncate text-xs text-muted-foreground">
                  {c.sections[s.id].title}
                </span>
              </a>
            ))
          }
          <a
            href="#daily"
            class="rounded-lg border border-border bg-card px-3 py-2 text-center transition hover:border-nav/40"
          >
            <span class="block text-lg font-bold tabular-nums text-foreground">
              {data.daily.length}
            </span>
            <span class="block truncate text-xs text-muted-foreground">
              {c.sections.daily.title}
            </span>
          </a>
        </div>
        <p
          class="mt-3 flex items-start gap-2 rounded-lg border border-border bg-muted/30 p-3 text-xs leading-relaxed text-muted-foreground"
        >
          <Icon name="lucide:info" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-nav" />
          {c.disclaimer}
        </p>
      </div>
    </div>
  </div>

  <!-- B. Mobile section chips — sticky under the site header (lg:hidden) -->
  <div class="lg:hidden sticky top-14 z-30 mt-8 border-b border-border bg-background/95 backdrop-blur">
    <div class:list={[WRAP, 'flex gap-2 overflow-x-auto py-2']}>
      {
        visible.map((s) => (
          <a
            href={`#${s.id}`}
            data-spy-link={s.id}
            class="flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-border bg-card px-3 py-1 text-xs text-muted-foreground transition hover:text-foreground"
          >
            <Icon name={s.icon} class="h-3.5 w-3.5 shrink-0 text-nav" />
            {c.sections[s.id].title}
            <span class="tabular-nums text-muted-foreground/70">{s.items.length}</span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- C. Daily digest — full-bleed horizontal band, the freshness signal -->
  <div id="daily" class="mt-8 scroll-mt-20 border-y border-border bg-muted/30 py-6">
    <div class:list={[WRAP]}>
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="flex items-center gap-2 text-lg font-bold tracking-tight text-foreground">
          <Icon name="lucide:calendar-days" class="h-5 w-5 shrink-0 text-nav" />
          {c.sections.daily.title}
          <span class="text-sm font-semibold tabular-nums text-nav">{data.daily.length}</span>
        </h2>
        <span class="text-sm text-muted-foreground">{c.sections.daily.hint}</span>
      </div>
      <div class="mt-4 flex gap-3 overflow-x-auto pb-2 [scrollbar-width:thin]">
        {
          data.daily.map((day, i) => (
            <article class="w-[280px] shrink-0 snap-start rounded-lg border border-border bg-card p-4">
              <p class="flex items-center gap-1.5 text-sm font-bold text-nav">
                {day.date}
                {i === 0 && (
                  <span class="rounded bg-nav/10 px-1.5 py-0.5 text-[11px] font-semibold">
                    {c.todayLabel}
                  </span>
                )}
                {i === 1 && (
                  <span class="rounded bg-nav/10 px-1.5 py-0.5 text-[11px] font-semibold">
                    {c.yesterdayLabel}
                  </span>
                )}
              </p>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{day.summary}</p>
              <div class="mt-2 flex flex-wrap gap-1">
                {day.topics.map((topic) => (
                  <span class={tagChip}>{topic}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <!-- D. Main: left sticky TOC + chapter sections with per-category density -->
  <div class:list={[WRAP, 'mt-10']}>
    <div
      class="grid gap-10 lg:grid-cols-[210px_minmax(0,1fr)] min-[1920px]:grid-cols-[240px_minmax(0,1fr)]"
    >
      <aside class="hidden lg:block">
        <nav class="sticky top-20" aria-label={c.tocLabel}>
          <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
            {c.tocLabel}
          </p>
          <ul class="mt-3 space-y-1">
            {
              visible.map((s) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    data-spy-link={s.id}
                    class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-muted-foreground transition hover:bg-muted hover:text-foreground"
                  >
                    <Icon name={s.icon} class="h-4 w-4 shrink-0" />
                    <span class="truncate">{c.sections[s.id].title}</span>
                    <span class="ml-auto text-xs tabular-nums text-muted-foreground/70">
                      {s.items.length}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class="min-w-0 space-y-14">
        {
          visible.map((s) => {
            const meta = c.sections[s.id];
            return (
              <section id={s.id} class="scroll-mt-28">
                <header class="mb-5 border-b border-border pb-3">
                  <h2 class="flex items-center gap-2.5 text-2xl font-bold tracking-tight text-foreground">
                    <Icon name={s.icon} class="h-5 w-5 shrink-0 text-nav" />
                    {meta.title}
                    <span class="text-sm font-semibold tabular-nums text-nav">
                      {s.items.length}
                    </span>
                  </h2>
                  <p class="mt-1 text-sm text-muted-foreground">{meta.hint}</p>
                </header>

                {s.id === 'gold' && (
                  <div class="grid gap-4 md:grid-cols-[repeat(auto-fill,minmax(430px,1fr))]">
                    {s.items.map((item) => (
                      <article class="relative rounded-xl border border-border bg-card p-5 transition hover:border-nav/40">
                        <span class:list={['absolute right-4 top-4', dateBadge]}>{item.date}</span>
                        <h3 class="pr-16 text-[15px] font-semibold leading-snug text-foreground">
                          {item.title}
                        </h3>
                        {item.attrib && (
                          <p class="mt-0.5 text-xs text-muted-foreground">— {item.attrib}</p>
                        )}
                        <p class="mt-2 text-sm leading-[1.8] text-muted-foreground">
                          {item.detail}
                        </p>
                        {item.tags && item.tags.length > 0 && (
                          <div class="mt-3 flex flex-wrap gap-1.5">
                            {item.tags.map((tag) => (
                              <span class={tagChip}>{tag}</span>
                            ))}
                          </div>
                        )}
                      </article>
                    ))}
                  </div>
                )}

                {s.id === 'pitfalls' && (
                  <div class="grid gap-4 md:grid-cols-[repeat(auto-fill,minmax(400px,1fr))]">
                    {s.items.map((item) => (
                      <article class="relative rounded-lg border border-border border-l-4 border-l-nav/60 bg-background p-4">
                        <span class:list={['absolute right-3.5 top-3.5', dateBadge]}>
                          {item.date}
                        </span>
                        <h3 class="pr-14 text-sm font-semibold leading-snug text-foreground">
                          {item.title}
                        </h3>
                        {item.attrib && (
                          <p class="mt-0.5 text-xs text-muted-foreground">— {item.attrib}</p>
                        )}
                        <p class="mt-2 text-sm leading-[1.8] text-muted-foreground">
                          {item.detail}
                        </p>
                        {item.tags && item.tags.length > 0 && (
                          <div class="mt-2.5 flex flex-wrap gap-1.5">
                            {item.tags.map((tag) => (
                              <span class={tagChip}>{tag}</span>
                            ))}
                          </div>
                        )}
                      </article>
                    ))}
                  </div>
                )}

                {s.id === 'qa' && (
                  <div class="grid gap-x-8 md:grid-cols-[repeat(auto-fill,minmax(380px,1fr))]">
                    {s.items.map((item) => (
                      <article class="border-b border-border py-3">
                        <h3 class="text-sm font-semibold leading-snug text-foreground">
                          <Icon
                            name="lucide:help-circle"
                            class="mr-1.5 inline-block h-3.5 w-3.5 text-nav"
                          />
                          {item.q}
                          {item.attrib && (
                            <span class="ml-2 text-xs font-normal text-muted-foreground">
                              {item.attrib}
                            </span>
                          )}
                        </h3>
                        <p class="mt-1.5 text-sm leading-[1.8] text-muted-foreground">{item.a}</p>
                      </article>
                    ))}
                  </div>
                )}

                {s.id === 'feedback' && (
                  <div class="grid gap-3 md:grid-cols-2">
                    {s.items.map((item) => (
                      <article
                        class:list={[
                          'rounded-lg border p-4',
                          item.status === 'open'
                            ? 'border-nav/40 bg-nav/5'
                            : 'border-border bg-background',
                        ]}
                      >
                        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                          <span class={dateBadge}>{item.date}</span>
                          <h3 class="text-sm font-semibold text-foreground">{item.title}</h3>
                          {item.status === 'open' && (
                            <span class="rounded-full border border-nav/30 px-2 py-0.5 text-[11px] font-medium text-nav">
                              {c.openLabel}
                            </span>
                          )}
                        </div>
                        <p class="mt-2 text-sm leading-[1.8] text-muted-foreground">
                          {item.detail}
                        </p>
                      </article>
                    ))}
                  </div>
                )}

                {s.id === 'news' && (
                  <div class="divide-y divide-border">
                    {s.items.map((item) => (
                      <article class="py-2.5">
                        <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                          <span class:list={['shrink-0', dateBadge]}>{item.date}</span>
                          <h3 class="text-sm font-medium text-foreground">{item.title}</h3>
                        </div>
                        <p class="mt-1 line-clamp-2 text-[13px] leading-relaxed text-muted-foreground">
                          {item.detail}
                        </p>
                      </article>
                    ))}
                  </div>
                )}
              </section>
            );
          })
        }

        <!-- CTA -->
        <div
          class="mt-14 rounded-xl border border-border bg-nav/5 p-8 text-center 2xl:flex 2xl:items-center 2xl:justify-between 2xl:py-6 2xl:text-left"
        >
          <div>
            <h2 class="text-2xl font-extrabold tracking-tight text-foreground">{c.cta.title}</h2>
            <p class="mt-2 text-muted-foreground">{c.cta.subtitle}</p>
          </div>
          <div class="mt-6 flex flex-wrap justify-center gap-3 2xl:mt-0 2xl:shrink-0 2xl:justify-end">
            <a href={c.cta.primaryHref} class="btn-primary inline-flex items-center gap-1.5">
              <Icon name="lucide:external-link" class="h-4 w-4" />
              {c.cta.primaryLabel}
            </a>
            <a href={c.cta.secondaryHref} class="btn-outline inline-flex items-center gap-1.5">
              {c.cta.secondaryLabel}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scroll-spy active state (see TableOfContents.astro pattern). */
  a[data-spy-link][data-active] {
    color: hsl(var(--brand-text));
    background-color: hsl(var(--brand-text) / 0.1);
    font-weight: 600;
  }
</style>

<script>
  // Scrollspy for the section nav — last heading scrolled past wins; the
  // mobile chip bar shares the same data-spy-link namespace and gets
  // centered on activation. Adapted from TableOfContents.astro.
  (() => {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-spy-link]'));
    if (links.length === 0) return;
    const ids = [...new Set(links.map((l) => l.getAttribute('data-spy-link') || ''))];
    const headings = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (headings.length === 0) return;

    const setActive = (id: string) => {
      for (const link of links) {
        if (link.getAttribute('data-spy-link') === id) {
          link.setAttribute('data-active', '');
          link.setAttribute('aria-current', 'true');
          link.scrollIntoView({ block: 'nearest', inline: 'center' });
        } else {
          link.removeAttribute('data-active');
          link.removeAttribute('aria-current');
        }
      }
    };

    let currentId = ids[0];
    const onScroll = () => {
      const line = window.scrollY + 140;
      let active = ids[0];
      for (const h of headings) {
        if (h.offsetTop <= line) active = h.id;
      }
      if (active !== currentId) {
        currentId = active;
        setActive(active);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    setActive(currentId);
    onScroll();
  })();
</script>
