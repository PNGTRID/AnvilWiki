---
/**
 * CommunityHighlights — the standalone "社群精华" page (/landing/community +
 * /zh/landing/community), v5 (expert-panel round 2: 内容减负+字号放大+秩序收敛):
 *
 *   [header: title+meta | borderless stat line + disclaimer]
 *   [full-bleed horizontal daily band — clickable, jumps to the report]
 *   [daily report card — date select, quotes+takeaways open, the rest folded]
 *   [five sections in a divide-y rhythm — uniform card/row anatomy, each
 *    shows the newest N items with a native <details> "show all" fold]
 *   [CTA — the page's single filled surface]
 *
 * Type scale: body 15/16px in foreground/80 (depth, not size, for hierarchy);
 * 12px is the hard floor for badges. Content strategy: newest-N windows keep
 * the default page length constant as automation appends daily. Renders the
 * AI-curated WeChat digest from community-digest.json; labels live in
 * landing.ts (`communityHighlights`); item content is Chinese source data on
 * both locales. apply-template removes the whole landing layer.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';
import digest from './community-digest.json';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
const c = t.communityHighlights;

interface DigestItem {
  date: string;
  title?: string;
  detail?: string;
  q?: string;
  a?: string;
  tags?: string[];
  attrib?: string;
  status?: string;
}
interface DailyReport {
  date: string;
  stats: { messages: number; speakers: number; peakHour: string; heat: string };
  quotes: { text: string; by: string }[];
  takeaways: string[];
  qa: { q: string; a: string; by?: string }[];
  resources: { title: string; note: string; by?: string }[];
  faq: { pattern: string; count: number }[];
  topics: { title: string; source: string }[];
}
interface CommunityDigest {
  schemaVersion: number;
  updated: string;
  since: string;
  categories: { id: string; items: DigestItem[] }[];
  daily: { date: string; summary: string; topics: string[] }[];
  reports?: DailyReport[];
}
const data = digest as CommunityDigest;

const byId = new Map(data.categories.map((cat) => [cat.id, cat.items]));
const SECTION_META = [
  { id: 'gold', icon: 'lucide:gem' },
  { id: 'pitfalls', icon: 'lucide:triangle-alert' },
  { id: 'qa', icon: 'lucide:messages-square' },
  { id: 'feedback', icon: 'lucide:megaphone' },
  { id: 'news', icon: 'lucide:rocket' },
] as const;
const visible = SECTION_META.map((s) => ({ ...s, items: byId.get(s.id) ?? [] })).filter(
  (s) => s.items.length > 0,
);

/** Default newest-N items per section — keeps the default page length constant. */
const VISIBLE: Record<string, number> = { gold: 6, pitfalls: 6, qa: 8, feedback: 6, news: 8 };
/** Per-section item grids (mins sized for 15/16px body). */
const GRIDS: Record<string, string> = {
  gold: 'grid gap-4 md:grid-cols-[repeat(auto-fill,minmax(500px,1fr))]',
  pitfalls: 'grid gap-4 md:grid-cols-[repeat(auto-fill,minmax(470px,1fr))]',
  qa: 'grid gap-x-8 md:grid-cols-[repeat(auto-fill,minmax(440px,1fr))]',
  feedback: 'grid gap-4 md:grid-cols-[repeat(auto-fill,minmax(460px,1fr))]',
};

const reports = data.reports ?? [];
/** Newest-N window for structured daily reports — keeps page weight
 * constant as automation appends one panel+option per day (same philosophy
 * as the section VISIBLE windows). Older days stay in the JSON for a
 * future archive page; daily-band cards older than the window simply
 * don't jump. */
const REPORTS_VISIBLE = 14;
const visibleReports = reports.slice(0, REPORTS_VISIBLE);
const dayLabels = new Map<string, string>();
if (reports.length > 0) dayLabels.set(reports[0].date, c.todayLabel);
if (reports.length > 1) dayLabels.set(reports[1].date, c.yesterdayLabel);

const WRAP = 'mx-auto w-full max-w-[1600px] px-4 sm:px-6 lg:px-8 2xl:max-w-[1728px] 2xl:px-10';
const dateBadge = 'rounded bg-nav/10 px-2 py-0.5 text-xs font-semibold tabular-nums text-nav';
const tagChip = 'rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground';
const CARD = 'rounded-lg border border-border bg-card p-4 sm:p-5';
const BODY = 'text-[15px] sm:text-base leading-[1.8] text-foreground/80';
---

<section class="py-12 md:py-16">
  <!-- A. Page header — value copy left, one borderless stat line + disclaimer right -->
  <div class:list={[WRAP]}>
    <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_420px] xl:items-start xl:gap-10">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
          {c.title}
        </h1>
        <p class="mt-3 max-w-3xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
          {c.subtitle}
        </p>
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:calendar-check" class="h-4 w-4 shrink-0 text-nav" />
            {c.updatedLabel}: {data.updated}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:history" class="h-4 w-4 shrink-0 text-nav" />
            {c.sinceLabel}: {data.since}
          </span>
        </p>
      </div>
      <div class="mt-6 xl:mt-0">
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
          {
            visible.map((s) => (
              <a href={`#${s.id}`} class="group inline-flex items-baseline gap-1.5">
                <span class="text-2xl font-bold tabular-nums text-foreground">{s.items.length}</span>
                <span class="text-[13px] text-muted-foreground transition group-hover:text-foreground">
                  {c.sections[s.id].title}
                </span>
              </a>
            ))
          }
          <a href="#daily" class="group inline-flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tabular-nums text-foreground">{data.daily.length}</span>
            <span class="text-[13px] text-muted-foreground transition group-hover:text-foreground">
              {c.sections.daily.title}
            </span>
          </a>
        </div>
        <p class="mt-4 max-w-xl text-[13px] leading-relaxed text-muted-foreground">
          {c.disclaimer}
        </p>
      </div>
    </div>
  </div>

  <!-- B. Mobile section chips — sticky under the site header (lg:hidden) -->
  <div class="lg:hidden sticky top-14 z-30 mt-8 border-b border-border bg-background/95 backdrop-blur">
    <div class:list={[WRAP, 'flex gap-2 overflow-x-auto py-2']}>
      {
        visible.map((s) => (
          <a
            href={`#${s.id}`}
            data-spy-link={s.id}
            class="flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-border bg-card px-3 py-1.5 text-[13px] text-muted-foreground transition hover:text-foreground"
          >
            <Icon name={s.icon} class="h-3.5 w-3.5 shrink-0 text-nav" />
            {c.sections[s.id].title}
            <span class="tabular-nums text-muted-foreground/70">{s.items.length}</span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- C. Daily digest — full-bleed horizontal band, the freshness signal -->
  <div id="daily" class="mt-8 scroll-mt-20 border-y border-border bg-muted/30 py-6">
    <div class:list={[WRAP]}>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <h2 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-foreground">
          <Icon name="lucide:calendar-days" class="h-5 w-5 shrink-0 text-nav" />
          {c.sections.daily.title}
        </h2>
        <span class="rounded-full bg-muted px-2.5 py-0.5 text-[13px] font-semibold tabular-nums text-muted-foreground">
          {data.daily.length}
        </span>
        <span class="text-[15px] text-muted-foreground">{c.sections.daily.hint}</span>
      </div>
      <div class="mt-4 flex gap-3 overflow-x-auto pb-2 [scrollbar-width:thin]">
        {
          data.daily.map((day, i) => (
            <article
              data-report-jump={day.date}
              title={c.report.title}
              class="w-[300px] shrink-0 cursor-pointer snap-start rounded-lg border border-border bg-card p-4 transition hover:border-nav/40 sm:w-[320px] sm:p-5"
            >
              <p class="flex items-center gap-2 text-[15px] font-bold text-nav">
                {day.date}
                {i === 0 && (
                  <span class="rounded bg-nav/10 px-2 py-0.5 text-xs font-semibold">
                    {c.todayLabel}
                  </span>
                )}
                {i === 1 && (
                  <span class="rounded bg-nav/10 px-2 py-0.5 text-xs font-semibold">
                    {c.yesterdayLabel}
                  </span>
                )}
              </p>
              <p class="mt-2 text-[15px] leading-[1.8] text-foreground/80 sm:text-base">{day.summary}</p>
              <div class="mt-2.5 flex flex-wrap gap-1.5">
                {day.topics.map((topic) => (
                  <span class={tagChip}>{topic}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <!-- D. Daily structured report — public subset; date select; slim default view -->
  {
    reports.length > 0 && (
      <div id="daily-report" class:list={[WRAP, 'mt-8 scroll-mt-20']}>
        <div class="rounded-xl border border-border bg-card p-4 sm:p-5">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <h2 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-foreground">
              <Icon name="lucide:newspaper" class="h-5 w-5 shrink-0 text-nav" />
              {c.report.title}
            </h2>
            <label class="ml-auto flex items-center gap-2 text-[13px] text-muted-foreground">
              <Icon name="lucide:calendar-search" class="h-4 w-4 shrink-0 text-nav" />
              <select
                data-report-select
                class="rounded-md border border-border bg-background px-2 py-1.5 text-sm font-medium text-foreground"
              >
                {visibleReports.map((r) => (
                  <option value={r.date}>
                    {r.date}
                    {dayLabels.has(r.date) ? ` · ${dayLabels.get(r.date)}` : ''}
                  </option>
                ))}
              </select>
            </label>
          </div>
          {visibleReports.map((r, i) => (
            <div data-report-panel={r.date} hidden={i > 0}>
              <div class="mt-4 flex flex-wrap gap-2 text-[13px]">
                <span class="rounded-full bg-muted px-2.5 py-1 text-muted-foreground">
                  {r.stats.messages} {c.report.statsMessages}
                </span>
                <span class="rounded-full bg-muted px-2.5 py-1 text-muted-foreground">
                  {r.stats.speakers} {c.report.statsSpeakers}
                </span>
                <span class="rounded-full bg-muted px-2.5 py-1 text-muted-foreground">
                  {c.report.statsPeak} {r.stats.peakHour}
                </span>
                <span class="rounded-full border border-nav/30 px-2.5 py-1 font-medium text-nav">
                  {r.stats.heat}
                </span>
              </div>

              <div class="mt-4 space-y-4">
                {r.quotes.length > 0 && (
                  <div>
                    <h3 class="flex items-center gap-2 text-base font-semibold text-foreground">
                      <Icon name="lucide:quote" class="h-4 w-4 shrink-0 text-nav" />
                      {c.report.quotesTitle}
                    </h3>
                    <ul class="mt-2 space-y-2">
                      {r.quotes.map((q) => (
                        <li class={`border-l-2 border-nav/30 pl-3 ${BODY}`}>
                          「{q.text}」<span class="text-[13px] text-muted-foreground">—— {q.by}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {r.takeaways.length > 0 && (
                  <div>
                    <h3 class="flex items-center gap-2 text-base font-semibold text-foreground">
                      <Icon name="lucide:list-checks" class="h-4 w-4 shrink-0 text-nav" />
                      {c.report.takeawaysTitle}
                    </h3>
                    <ul class="mt-2 space-y-2">
                      {r.takeaways.map((item) => (
                        <li class={`flex gap-2 ${BODY}`}>
                          <span class="mt-[11px] h-1 w-1 shrink-0 rounded-full bg-nav/50" />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {r.qa.length > 0 && (
                  <details class="group/rep">
                    <summary class="flex cursor-pointer list-none items-center gap-2 text-base font-semibold text-foreground">
                      <Icon name="lucide:messages-square" class="h-4 w-4 shrink-0 text-nav" />
                      {c.report.qaTitle}
                      <span class="rounded-full bg-muted px-2 py-0.5 text-[13px] text-muted-foreground">
                        {r.qa.length}
                      </span>
                      <Icon name="lucide:chevron-down" class="chev ml-auto h-4 w-4 text-muted-foreground" />
                    </summary>
                    <ul class="mt-2 space-y-2">
                      {r.qa.map((item) => (
                        <li class={BODY}>
                          <span class="font-semibold text-foreground">{item.q}</span>
                          <span> — {item.a}</span>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
                {r.resources.length > 0 && (
                  <details class="group/rep">
                    <summary class="flex cursor-pointer list-none items-center gap-2 text-base font-semibold text-foreground">
                      <Icon name="lucide:link" class="h-4 w-4 shrink-0 text-nav" />
                      {c.report.resourcesTitle}
                      <span class="rounded-full bg-muted px-2 py-0.5 text-[13px] text-muted-foreground">
                        {r.resources.length}
                      </span>
                      <Icon name="lucide:chevron-down" class="chev ml-auto h-4 w-4 text-muted-foreground" />
                    </summary>
                    <ul class="mt-2 space-y-2">
                      {r.resources.map((res) => (
                        <li class={BODY}>
                          <span class="font-semibold text-foreground">{res.title}</span>
                          {res.note && <span>：{res.note}</span>}
                          {res.by && <span class="text-[13px] text-muted-foreground">（{res.by}）</span>}
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
                {(r.faq.length > 0 || r.topics.length > 0) && (
                  <details class="group/rep">
                    <summary class="flex cursor-pointer list-none items-center gap-2 text-base font-semibold text-foreground">
                      <Icon name="lucide:pen-line" class="h-4 w-4 shrink-0 text-nav" />
                      {c.report.faqTitle} · {c.report.topicsTitle}
                      <span class="rounded-full bg-muted px-2 py-0.5 text-[13px] text-muted-foreground">
                        {r.faq.length + r.topics.length}
                      </span>
                      <Icon name="lucide:chevron-down" class="chev ml-auto h-4 w-4 text-muted-foreground" />
                    </summary>
                    <div class="mt-2 space-y-3">
                      {r.faq.length > 0 && (
                        <div class="flex flex-wrap gap-1.5">
                          {r.faq.map((f) => (
                            <span class="rounded bg-muted px-2 py-1 text-[13px] text-muted-foreground">
                              {f.pattern} ×{f.count}
                            </span>
                          ))}
                        </div>
                      )}
                      {r.topics.length > 0 && (
                        <ul class="space-y-1.5">
                          {r.topics.map((topic) => (
                            <li class={BODY}>《{topic.title}》</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </details>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <!-- E. Sections — uniform anatomy, divide-y rhythm, newest-N + show-all fold -->
  <div class:list={[WRAP, 'mt-8']}>
    <div class="grid gap-10 lg:grid-cols-[210px_minmax(0,1fr)] min-[1920px]:grid-cols-[240px_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <nav class="sticky top-20" aria-label={c.tocLabel}>
          <p class="text-[13px] font-semibold uppercase tracking-wider text-muted-foreground">
            {c.tocLabel}
          </p>
          <ul class="mt-3 space-y-1">
            {
              visible.map((s) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    data-spy-link={s.id}
                    class="flex items-center gap-2 rounded-md px-2 py-1.5 text-[15px] text-muted-foreground transition hover:bg-muted hover:text-foreground"
                  >
                    <Icon name={s.icon} class="h-4 w-4 shrink-0" />
                    <span class="truncate">{c.sections[s.id].title}</span>
                    <span class="ml-auto text-[13px] tabular-nums text-muted-foreground/70">
                      {s.items.length}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
      <div class="min-w-0">
    <div class="divide-y divide-border">
      {
        visible.map((s) => {
          const meta = c.sections[s.id];
          const n = VISIBLE[s.id] ?? 6;
          const head = s.items.slice(0, n);
          const tail = s.items.slice(n);
          const fold = (items: DigestItem[]) => (
            <details>
              <summary class="flex cursor-pointer list-none items-center justify-center gap-2 rounded-lg border border-dashed border-border px-4 py-2.5 text-sm text-muted-foreground transition hover:border-nav/40 hover:text-nav">
                <Icon name="lucide:chevron-down" class="chev h-4 w-4" />
                {c.expandLabel}（{s.items.length}）
              </summary>
              <div class:list={['mt-4', GRIDS[s.id] ?? '']}>{items.map(renderItem(s.id))}</div>
            </details>
          );
          const renderItem = (id: string) => (item: DigestItem) => {
            if (id === 'gold') {
              return (
                <article class={`${CARD} relative`}>
                  <span class:list={['absolute right-4 top-4', dateBadge]}>{item.date}</span>
                  <h3 class="pr-24 text-[17px] font-semibold leading-snug text-foreground sm:text-lg">
                    {item.title}
                  </h3>
                  {item.attrib && (
                    <p class="mt-1 text-[13px] text-muted-foreground">— {item.attrib}</p>
                  )}
                  <p class={`mt-2 ${BODY}`}>{item.detail}</p>
                  {item.tags && item.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {item.tags.map((tag) => (
                        <span class={tagChip}>{tag}</span>
                      ))}
                    </div>
                  )}
                </article>
              );
            }
            if (id === 'pitfalls') {
              return (
                <article class={`${CARD} relative border-l-2 border-l-nav/60`}>
                  <span class:list={['absolute right-4 top-4', dateBadge]}>{item.date}</span>
                  <h3 class="pr-24 text-base font-semibold leading-snug text-foreground sm:text-[17px]">
                    {item.title}
                  </h3>
                  {item.attrib && (
                    <p class="mt-1 text-[13px] text-muted-foreground">— {item.attrib}</p>
                  )}
                  <p class={`mt-2 ${BODY}`}>{item.detail}</p>
                  {item.tags && item.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {item.tags.map((tag) => (
                        <span class={tagChip}>{tag}</span>
                      ))}
                    </div>
                  )}
                </article>
              );
            }
            if (id === 'qa') {
              return (
                <article class="border-b border-border py-3.5">
                  <h3 class="text-base font-semibold leading-snug text-foreground sm:text-[17px]">
                    <Icon name="lucide:help-circle" class="mr-1.5 inline-block h-4 w-4 text-nav" />
                    {item.q}
                    {item.attrib && (
                      <span class="ml-2 text-[13px] font-normal text-muted-foreground">
                        {item.attrib}
                      </span>
                    )}
                  </h3>
                  <p class={`mt-1.5 ${BODY}`}>{item.a}</p>
                </article>
              );
            }
            if (id === 'feedback') {
              return (
                <article class={CARD}>
                  <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                    <span class={dateBadge}>{item.date}</span>
                    <h3 class="text-base font-semibold text-foreground">{item.title}</h3>
                    {item.status === 'open' && (
                      <span class="rounded border border-nav/30 px-2 py-0.5 text-xs font-medium text-nav">
                        {c.openLabel}
                      </span>
                    )}
                  </div>
                  <p class={`mt-2 ${BODY}`}>{item.detail}</p>
                </article>
              );
            }
            return (
              <article class="py-3">
                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                  <span class="shrink-0">{item.date}</span>
                  <h3 class="text-[15px] font-medium text-foreground sm:text-base">{item.title}</h3>
                </div>
                <p class={`mt-1 line-clamp-2 ${BODY}`}>{item.detail}</p>
              </article>
            );
          };
          return (
            <section id={s.id} class="scroll-mt-28 py-8 first:pt-0 lg:py-10">
              <header class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <h2 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-foreground">
                  <Icon name={s.icon} class="h-5 w-5 shrink-0 text-nav" />
                  {meta.title}
                </h2>
                <span class="rounded-full bg-muted px-2.5 py-0.5 text-[13px] font-semibold tabular-nums text-muted-foreground">
                  {s.items.length}
                </span>
                <span class="text-[15px] text-muted-foreground">{meta.hint}</span>
              </header>
              <div class="mt-5">
                <div class:list={[GRIDS[s.id] ?? '', s.id === 'news' ? 'max-w-3xl divide-y divide-border' : '']}>
                  {head.map(renderItem(s.id))}
                </div>
                {tail.length > 0 && fold(tail)}
              </div>
            </section>
          );
        })
      }
    </div>

    <!-- F. CTA — the page's single filled surface -->
    <div class="mt-10 rounded-xl bg-nav/5 p-6 text-center sm:p-8 2xl:flex 2xl:items-center 2xl:justify-between 2xl:py-6 2xl:text-left">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-foreground">{c.cta.title}</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground sm:text-base">
          {c.cta.subtitle}
        </p>
      </div>
      <div class="mt-6 flex flex-wrap justify-center gap-3 2xl:mt-0 2xl:shrink-0 2xl:justify-end">
        <a href={c.cta.primaryHref} class="btn-primary inline-flex items-center gap-1.5">
          <Icon name="lucide:external-link" class="h-4 w-4" />
          {c.cta.primaryLabel}
        </a>
        <a href={c.cta.secondaryHref} class="btn-outline inline-flex items-center gap-1.5">
          {c.cta.secondaryLabel}
        </a>
      </div>
    </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scroll-spy active state (see TableOfContents.astro pattern). */
  a[data-spy-link][data-active] {
    color: hsl(var(--brand-text));
    background-color: hsl(var(--brand-text) / 0.1);
    font-weight: 600;
  }
  /* Fold chevrons + native marker cleanup. */
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary .chev {
    transition: transform 150ms ease;
  }
  details[open] > summary .chev {
    transform: rotate(180deg);
  }
</style>

<script>
  // Daily-report day switcher: the <select> toggles panels; clicking a card
  // in the daily band selects that day and scrolls to the report.
  (() => {
    const select = document.querySelector<HTMLSelectElement>('select[data-report-select]');
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-report-panel]'));
    if (!select || panels.length === 0) return;
    const show = (date: string) => {
      for (const panel of panels) {
        panel.hidden = panel.getAttribute('data-report-panel') !== date;
      }
    };
    select.addEventListener('change', () => show(select.value));
    for (const jump of document.querySelectorAll<HTMLElement>('[data-report-jump]')) {
      jump.addEventListener('click', () => {
        const date = jump.getAttribute('data-report-jump') || '';
        if (!panels.some((panel) => panel.getAttribute('data-report-panel') === date)) return;
        show(date);
        select.value = date;
        document.getElementById('daily-report')?.scrollIntoView({ behavior: 'smooth' });
      });
    }
  })();
</script>

<script>
  // Scrollspy for the section nav — last heading scrolled past wins; the
  // mobile chip bar shares the same data-spy-link namespace and gets
  // centered on activation. Adapted from TableOfContents.astro.
  (() => {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-spy-link]'));
    if (links.length === 0) return;
    const ids = [...new Set(links.map((l) => l.getAttribute('data-spy-link') || ''))];
    const headings = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (headings.length === 0) return;

    const setActive = (id: string) => {
      for (const link of links) {
        if (link.getAttribute('data-spy-link') === id) {
          link.setAttribute('data-active', '');
          link.setAttribute('aria-current', 'true');
          link.scrollIntoView({ block: 'nearest', inline: 'center' });
        } else {
          link.removeAttribute('data-active');
          link.removeAttribute('aria-current');
        }
      }
    };

    let currentId = ids[0];
    const onScroll = () => {
      const line = window.scrollY + 140;
      let active = ids[0];
      for (const h of headings) {
        if (h.offsetTop <= line) active = h.id;
      }
      if (active !== currentId) {
        currentId = active;
        setActive(active);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    setActive(currentId);
    onScroll();
  })();
</script>
