---
/**
 * AuthorCard — the "About the author" section on the landing root: who
 * builds AnvilWiki, why, and where to find them. Copy comes from the
 * landing-en/zh.ts `author` pair — part of the landing demo-identity layer,
 * so apply-template removes it together with the rest of the landing files.
 * Avatar is the maintainer's own image (/images/author-avatar.jpg) — a fork
 * deleting the landing layer removes this whole card, so no preset leak.
 */
import { Icon } from 'astro-icon/components';
import type { LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
const author = t.author;
---

<section class="section border-t border-border">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-center text-3xl font-extrabold tracking-tight text-foreground">
      {author.title}
    </h2>
    <div class="mt-8 rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
      <div class="flex items-center gap-4">
        <img
          src="/images/author-avatar.jpg"
          alt={author.name}
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
          class="h-14 w-14 shrink-0 rounded-full border border-border object-cover"
        />
        <div>
          <p class="font-bold text-foreground">{author.name}</p>
          <p class="text-sm text-muted-foreground">{author.role}</p>
        </div>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-foreground/80">{author.bio}</p>
      <div class="mt-5 flex flex-wrap gap-2.5">
        {author.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-3 py-1.5 text-sm font-medium text-foreground/80 transition hover:border-primary/40 hover:text-primary"
          >
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
