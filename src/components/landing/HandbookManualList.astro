---
/**
 * HandbookManualList — a single manual's own page: hero + a numbered
 * chapter LIST (one row per chapter: order badge, title, one-line
 * description, arrow). List view reads like a course TOC — more direct
 * than the old card grid.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';
import {
  handbookPath,
  parseHandbookId,
  type HandbookEntry,
  type HandbookLocale,
  type HandbookManual,
} from '~/lib/handbook';

interface Props {
  manual: HandbookManual;
  chapters: HandbookEntry[];
  locale: HandbookLocale;
  t: LandingContent;
}
const { manual, chapters, locale, t } = Astro.props;
const manualIcons: Record<HandbookManual, string> = {
  learn: 'lucide:graduation-cap',
  dev: 'lucide:wrench',
};
const items = chapters.filter((c) => c.data.manual === manual);

/**
 * Flatten into render rows, inserting a stage header whenever the chapter's
 * `stage` label changes (chapters without a stage render flat — dev manual).
 * `items` arrives order-sorted, so consecutive same-stage chapters group up.
 */
type Row = { type: 'stage'; label: string } | { type: 'chapter'; chapter: HandbookEntry };
const rows: Row[] = [];
let lastStage: string | undefined;
for (const chapter of items) {
  if (chapter.data.stage && chapter.data.stage !== lastStage) {
    lastStage = chapter.data.stage;
    rows.push({ type: 'stage', label: chapter.data.stage });
  }
  rows.push({ type: 'chapter', chapter });
}
---

<section class="section">
  <div class="mx-auto max-w-3xl">
    <nav
      aria-label="Breadcrumb"
      class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground"
    >
      <a href={handbookPath(locale, '', true)} class="transition hover:text-nav">
        {t.handbook.backToHub}
      </a>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <span aria-current="page" class="text-foreground">{t.handbook.manuals[manual].label}</span>
    </nav>

    <header class="mt-6 flex items-start gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-nav/10 text-nav">
        <Icon name={manualIcons[manual]} class="h-6 w-6" />
      </div>
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-foreground">
          {t.handbook.manuals[manual].label}
        </h1>
        <p class="mt-2 text-muted-foreground">{t.handbook.manuals[manual].description}</p>
        <p class="mt-1 text-xs text-muted-foreground">
          {items.length} {t.handbook.chaptersCountLabel}
        </p>
      </div>
    </header>

    <ol class="mt-8 divide-y divide-border rounded-lg border border-border bg-card">
      {rows.map((row) =>
        row.type === 'stage' ? (
          <li
            class="bg-muted/40 px-4 py-2 text-xs font-bold uppercase tracking-wide text-muted-foreground sm:px-5"
          >
            {row.label}
          </li>
        ) : (
          <li>
            <a
              href={handbookPath(locale, parseHandbookId(row.chapter.id)?.slug ?? '')}
              class="group flex items-center gap-4 px-4 py-4 transition hover:bg-muted sm:px-5"
            >
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-nav/10 text-sm font-bold text-nav">
                {row.chapter.data.order}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-foreground transition group-hover:text-nav">
                  {row.chapter.data.title}
                </span>
                <span class="mt-0.5 block truncate text-sm text-muted-foreground">
                  {row.chapter.data.description}
                </span>
              </span>
              <Icon
                name="lucide:arrow-right"
                class="h-4 w-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-nav"
              />
            </a>
          </li>
        )
      )}
    </ol>
  </div>
</section>
