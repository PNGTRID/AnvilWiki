---
/**
 * HandbookChapter — the chapter page body for /landing/docs/[slug].
 * Three-column layout from lg up: manual tree (HandbookNav) | chapter prose
 * | on-page TOC (reuses the wiki TableOfContents with desktopAt="lg").
 * Below lg both trees collapse into <details> blocks around the content.
 * Renders breadcrumb, chapter meta, TL;DR card, prev/next within the same
 * manual, and an "Edit on GitHub" link. Labels come from landing.ts.
 */
import { Icon } from 'astro-icon/components';
import TableOfContents from '~/components/article/TableOfContents.astro';
import { type LandingContent } from '~/config/landing';
import HandbookNav from '~/components/landing/HandbookNav.astro';
import {
  handbookPath,
  handbookSourceUrl,
  parseHandbookId,
  type HandbookEntry,
  type HandbookLocale,
} from '~/lib/handbook';

interface Props {
  locale: HandbookLocale;
  chapter: HandbookEntry;
  t: LandingContent;
  /** All chapters of this locale (feeds the left manual tree). */
  chapters: HandbookEntry[];
  /** Headings from render() — feeds the right on-page TOC. */
  headings: { depth: number; slug: string; text: string }[];
  prev: HandbookEntry | null;
  next: HandbookEntry | null;
}

const { locale, chapter, t, chapters, headings, prev, next } = Astro.props;
const slug = parseHandbookId(chapter.id)?.slug ?? '';
const manualLabel = t.handbook.manuals[chapter.data.manual].label;
const chapterNo = `${t.handbook.chapterLabel} ${chapter.data.order}${t.handbook.chapterSuffix}`;
const updated = chapter.data.updated?.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<section class="section">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 justify-center gap-8 lg:grid-cols-[11.5rem_minmax(0,1fr)_11.5rem] xl:grid-cols-[13rem_minmax(0,48rem)_13.5rem]"
  >
    {/* Left: manual tree */}
    <HandbookNav chapters={chapters} currentId={chapter.id} locale={locale} t={t} />

    {/* Center: the chapter itself. data-pagefind-body opts this page into
        the Pagefind index (its rule: once ANY page marks a body, unmarked
        pages are excluded site-wide) — without it the 41 handbook lessons
        are invisible to site search. Breadcrumb/footer stay out. */}
    <article data-pagefind-body class="mx-auto w-full min-w-0 max-w-3xl xl:mx-0">
      <!-- Breadcrumb: docs hub → manual → chapter -->
      <nav
        data-pagefind-ignore
        aria-label="Breadcrumb"
        class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground"
      >
        <a href={handbookPath(locale, '', true)} class="transition hover:text-nav">
          {t.handbook.backToHub}
        </a>
        <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
        <a href={handbookPath(locale, chapter.data.manual)} class="transition hover:text-nav">
          {manualLabel}
        </a>
        <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
        <span aria-current="page" class="text-foreground">{chapterNo}</span>
      </nav>

      <header class="mt-6">
        <div class="flex flex-wrap items-center gap-3">
          <span
            class="inline-flex items-center gap-1.5 rounded-full bg-nav/10 px-2.5 py-0.5 text-xs font-semibold text-nav"
          >
            <Icon name={chapter.data.icon} class="h-3.5 w-3.5" />
            {chapterNo}
          </span>
          {chapter.data.stage && (
            <span class="text-xs text-muted-foreground">· {chapter.data.stage}</span>
          )}
          {updated && (
            <span class="text-xs text-muted-foreground">
              {t.handbook.updatedLabel} {updated}
            </span>
          )}
        </div>
        <h1
          data-pagefind-meta={`title:${chapter.data.title}`}
          class="mt-3 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl"
        >
          {chapter.data.title}
        </h1>
        <p class="mt-3 text-lg text-muted-foreground">{chapter.data.description}</p>
      </header>

      {chapter.data.tldr && (
        <aside
          class="mt-6 rounded-lg border-l-4 border-nav bg-nav/5 px-4 py-3"
          aria-label={t.handbook.tldrLabel}
        >
          <p class="text-xs font-bold uppercase tracking-wide text-nav">{t.handbook.tldrLabel}</p>
          <p class="mt-1 text-sm leading-relaxed text-foreground/90">{chapter.data.tldr}</p>
        </aside>
      )}

      {/* On-page TOC — collapsible below lg (the sticky right column takes over then) */}
      <div class="mt-6 lg:hidden">
        <TableOfContents headings={headings} heading={t.handbook.onThisPageLabel} desktopAt="lg" />
      </div>

      <div
        class="prose prose-lg mt-8 max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-a:text-nav"
      >
        <slot />
      </div>

      <!-- Chapter footer: prev / next within the same manual + edit link -->
      <footer data-pagefind-ignore class="mt-12 border-t border-border pt-6">
        <div class="grid gap-3 sm:grid-cols-2">
          {prev ? (
            <a
              href={handbookPath(locale, parseHandbookId(prev.id)?.slug ?? '')}
              class="card group flex flex-col gap-1 p-4"
            >
              <span class="text-xs font-medium text-muted-foreground">
                ← {t.handbook.prevLabel}
              </span>
              <span class="font-semibold text-foreground transition group-hover:text-nav">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <span class="hidden sm:block"></span>
          )}
          {next && (
            <a
              href={handbookPath(locale, parseHandbookId(next.id)?.slug ?? '')}
              class="card group flex flex-col items-end gap-1 p-4 text-right"
            >
              <span class="text-xs font-medium text-muted-foreground">
                {t.handbook.nextLabel} →
              </span>
              <span class="font-semibold text-foreground transition group-hover:text-nav">
                {next.data.title}
              </span>
            </a>
          )}
        </div>
        <div class="mt-6 flex justify-between gap-4 text-sm">
          <a
            href={handbookPath(locale, '', true)}
            class="inline-flex items-center gap-1 text-muted-foreground transition hover:text-nav"
          >
            <Icon name="lucide:arrow-left" class="h-3.5 w-3.5" />
            {t.handbook.backToHub}
          </a>
          <a
            href={handbookSourceUrl(locale, slug)}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1 text-muted-foreground transition hover:text-nav"
          >
            <Icon name="lucide:pencil" class="h-3.5 w-3.5" />
            {t.handbook.editLabel}
          </a>
        </div>
      </footer>
    </article>

    {/* Right: on-page TOC (sticky) */}
    <aside class="hidden lg:block">
      <TableOfContents headings={headings} heading={t.handbook.onThisPageLabel} desktopAt="lg" />
    </aside>
  </div>
</section>
