---
/**
 * LandingLayout — the shell for the project landing pages (/landing, /zh/landing).
 *
 * Wraps BaseLayout with a minimal header (logo + language toggle + GitHub +
 * theme toggle) and a simplified footer. Does NOT use SiteHeader (that's the
 * demo game's navigation) or StickyBanner (ads) — the landing page is about
 * the project, not the demo game.
 */
import BaseLayout from '~/components/layout/BaseLayout.astro';
import ThemeToggle from '~/components/header/ThemeToggle.astro';
import SearchButton from '~/components/header/SearchButton.astro';
import { Icon } from 'astro-icon/components';
import {
  landingContent,
  landingPath,
  type LandingLocale,
} from '~/config/landing';
import { websiteJsonLd } from '~/lib/seo';
import { defaultLocale, type Locale } from '~/i18n/routing';
import { handbookPath } from '~/lib/handbook';

interface Props {
  locale: LandingLocale;
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
  /** Override the <title> (docs pages: "{chapter} | AnvilWiki Docs"). */
  pageTitle?: string;
  /** Override the meta description. */
  pageDescription?: string;
  /**
   * Where the header language toggle should link. Defaults to the other
   * locale's landing root; docs pages pass the equivalent docs path so the
   * toggle keeps you inside the docs center.
   */
  togglePath?: string;
  /** Extra JSON-LD objects appended after the default WebSite one. */
  extraJsonLd?: Record<string, unknown>[];
  /**
   * Render the Pagefind search button in the header. On by default — the
   * index spans the whole site (wiki articles + handbook + the landing
   * pages themselves, incl. the community digest), so every landing page
   * is a search entry point. Docs pages used to be the only opt-ins back
   * when landing pages weren't indexed. Labels come from landing.ts `search`.
   */
  search?: boolean;
  /**
   * Ultra-wide mode: header/footer inner containers follow the community
   * page's stepped max-width (1600px → 1728px at 2xl) so their edges stay
   * aligned with that page's ultra-wide content. Default (false) keeps the
   * site-wide max-w-7xl.
   */
  wide?: boolean;
};
const {
  locale,
  alternates = [],
  pageTitle,
  pageDescription,
  togglePath,
  extraJsonLd = [],
  search = true,
  wide = false,
} = Astro.props;
const t = landingContent[locale];
const other: LandingLocale = locale === 'en' ? 'zh' : 'en';
const jsonLd = [websiteJsonLd((locale === 'en' ? defaultLocale : 'zh') as Locale), ...extraJsonLd];
const title = pageTitle ?? t.title;
const description = pageDescription ?? t.description;
---

<BaseLayout
  title={title}
  description={description}
  locale={t.htmlLang}
  titleSuffix="AnvilWiki"
  jsonLd={jsonLd}
  alternates={alternates}
  consent={t.consent}
>
  {/* Locale auto-detect + preference memory (runs before anything renders):
      1. Manual toggle always wins (stored in localStorage by the toggle links).
      2. No stored preference + Chinese browser → serve the Chinese page.
      3. Otherwise stay (someone may have been linked here directly).
      Scoped to the landing ROOT pages only — redirecting someone away from
      /landing/docs/<chapter> would drop the chapter they were reading (the
      docs center has its own per-page language toggle).
      Trailing-slash tolerant: the site builds with trailingSlash:'always', so
      the browser always sees '/landing/' and '/zh/landing/' — the exact-string
      check that used to live here never matched and the whole block was dead
      code in production. Redirect targets carry the slash too, so the fix
      doesn't just add a 308 hop.
      Crawlers are excluded from the auto-detect branch: headless renderers
      follow JS redirects, which would turn /landing into a conditional
      redirect for zh-locale crawlbots and muddy the canonical/hreflang
      signals. */}
  <script is:inline>
    (() => {
      try {
        const stored = localStorage.getItem('landing-lang');
        const isRoot = /^\/(zh\/)?landing\/?$/.test(location.pathname);
        if (!isRoot) return;
        const isZhPage = location.pathname.startsWith('/zh/');
        const isBot = /bot|crawler|spider|crawl|slurp|bingpreview|lighthouse/i.test(
          navigator.userAgent,
        );
        if (stored === 'en' && isZhPage) {
          location.replace('/landing/');
        } else if (stored === 'zh' && !isZhPage) {
          location.replace('/zh/landing/');
        } else if (!stored && !isZhPage && !isBot) {
          const lang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
          if (lang.startsWith('zh')) location.replace('/zh/landing/');
        }
      } catch (e) {
        /* storage unavailable — keep the current page */
      }
    })();
  </script>

  {/* Announcement bar (optional — see landing.ts). Dismissible: the X
      persists to localStorage keyed by the announcement TEXT, so dismissing
      hides this entry but a future release's new text shows again (same
      degrade-to-no-remember pattern as StickyBanner when storage is blocked).
      line-clamped so a long entry can't stack 3+ rows on phones. */}
  {t.announcement && (
    <div
      id="announcement-bar"
      data-announce-text={t.announcement.text}
      class="relative bg-nav/10 py-1.5 pl-4 pr-10 text-center text-xs font-medium text-nav"
    >
      {/* line-clamp-2 alone on purpose — pairing it with `block` lets the
          later display:block declaration win and silently kill the clamp. */}
      <a href={t.announcement.href} class="line-clamp-2 transition hover:text-foreground">
        {t.announcement.text}
      </a>
      <button
        id="dismiss-announcement"
        type="button"
        aria-label={t.announcement.dismissLabel}
        class="absolute right-2 top-1/2 inline-flex h-6 w-6 -translate-y-1/2 items-center justify-center rounded-md text-nav/70 transition hover:bg-nav/15 hover:text-nav"
      >
        <Icon name="lucide:x" class="h-3.5 w-3.5" />
      </button>
    </div>
  )}
  <script is:inline>
    /* ES2018 only — no optional chaining, no nullish coalescing, no optional
       catch binding: this runs untranspiled in the HTML and old in-app
       webviews (WeChat X5, pre-13.4 Safari) parse it — a SyntaxError here
       kills announcement dismissal. */
    (() => {
      const bar = document.getElementById('announcement-bar');
      if (!bar) return;
      let dismissedFor = '';
      try {
        dismissedFor = localStorage.getItem('landing-announcement-dismissed') || '';
      } catch (e) {
        /* storage unavailable — dismiss still works, just not remembered */
      }
      if (dismissedFor && dismissedFor === bar.getAttribute('data-announce-text')) {
        bar.remove();
        return;
      }
      const dismissBtn = document.getElementById('dismiss-announcement');
      if (dismissBtn) {
        dismissBtn.addEventListener('click', () => {
          try {
            localStorage.setItem('landing-announcement-dismissed', bar.getAttribute('data-announce-text') || '');
          } catch (e) {
            /* storage unavailable */
          }
          bar.remove();
        });
      }
    })();
  </script>

  {/* Minimal header — logo + language + GitHub + theme toggle */}
  <header class="sticky top-0 z-40 w-full border-b border-border bg-background/80 backdrop-blur">
    <div
      class:list={[
        'mx-auto flex h-14 items-center gap-4',
        wide
          ? 'max-w-[1600px] px-4 sm:px-6 lg:px-8 2xl:max-w-[1728px] 2xl:px-10'
          : 'max-w-7xl px-4',
      ]}
    >
      {/* Mobile menu — native <details>, zero JS (same pattern as the wiki
          SiteHeader), pinned TOP-LEFT before the brand (user request). The
          sm+ nav links below are display:none below 640px, so without this
          the community/GitHub/demo pages were unreachable on phones. */}
      <details class="relative sm:hidden">
        <summary
          class="inline-flex h-9 w-9 shrink-0 cursor-pointer list-none items-center justify-center rounded-md text-foreground transition hover:bg-muted"
        >
          <Icon name="lucide:menu" class="h-5 w-5" />
        </summary>
        <div class="absolute left-0 mt-2 w-56 overflow-hidden rounded-md border bg-card shadow-lg">
          {search && (
            <button
              type="button"
              data-open-search
              class="flex w-full items-center gap-2 border-b border-border px-3 py-2.5 text-sm font-medium text-nav transition hover:bg-muted"
            >
              <Icon name="lucide:search" class="h-4 w-4" />
              <span>{t.search.label}</span>
            </button>
          )}
          <a
            href={`${handbookPath(locale, '', true)}#learn`}
            class="flex items-center gap-2 px-3 py-2 text-sm transition hover:bg-muted"
          >
            <Icon name="lucide:graduation-cap" class="h-4 w-4" />
            <span>{t.handbook.manuals.learn.label}</span>
          </a>
          <a
            href={`${handbookPath(locale, '', true)}#dev`}
            class="flex items-center gap-2 px-3 py-2 text-sm transition hover:bg-muted"
          >
            <Icon name="lucide:wrench" class="h-4 w-4" />
            <span>{t.handbook.manuals.dev.label}</span>
          </a>
          <a
            href={locale === 'en' ? '/landing/community/' : '/zh/landing/community/'}
            class="flex items-center gap-2 px-3 py-2 text-sm transition hover:bg-muted"
          >
            <Icon name="lucide:messages-square" class="h-4 w-4" />
            <span>{t.communityHighlights.navLabel}</span>
          </a>
          <a
            href="https://github.com/PNGTRID/AnvilWiki"
            class="flex items-center gap-2 px-3 py-2 text-sm transition hover:bg-muted"
          >
            <Icon name="lucide:star" class="h-4 w-4" />
            <span>GitHub</span>
          </a>
          <a
            href="/"
            class="flex items-center gap-2 border-t border-border px-3 py-2 text-sm text-muted-foreground transition hover:bg-muted hover:text-nav"
          >
            <Icon name="lucide:external-link" class="h-4 w-4" />
            <span>Demo</span>
          </a>
        </div>
      </details>
      <a href={landingPath(locale)} class="flex shrink-0 items-center gap-2 font-bold text-foreground">
        <Icon name="lucide:hammer" class="h-6 w-6 text-nav" />
        <span>AnvilWiki</span>
      </a>
      {/* Field pill renders only from sm+ (the full-width search bar row
          replaces it on phones — see its trigger classes). The <dialog>
          itself ALWAYS stays mounted here and must never sit inside a
          display:none subtree: old webviews without <dialog>.showModal()
          fall back to a non-modal open dialog, which cannot escape a
          hidden ancestor the way the top layer does. */}
      {search && (
        <SearchButton
          variant="field"
          labels={{
            trigger: t.search.label,
            placeholder: t.search.placeholder,
            noResults: t.search.noResults,
            close: t.search.close,
          }}
        />
      )}
      <div class="ml-auto flex items-center gap-3">
        <a
          href={togglePath ?? landingPath(other)}
          hreflang={other}
          onclick={`localStorage.setItem('landing-lang','${other}')`}
          class="rounded-md border border-border px-2 py-1 text-xs font-medium text-muted-foreground transition hover:text-nav"
        >
          {other === 'zh' ? '中文' : 'EN'}
        </a>
        <a
          href={`${handbookPath(locale, '', true)}#learn`}
          class="hidden items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-foreground/70 transition hover:bg-muted hover:text-foreground sm:inline-flex"
        >
          <Icon name="lucide:graduation-cap" class="h-4 w-4" />
          <span>{t.handbook.manuals.learn.label}</span>
        </a>
        <a
          href={`${handbookPath(locale, '', true)}#dev`}
          class="hidden items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-foreground/70 transition hover:bg-muted hover:text-foreground sm:inline-flex"
        >
          <Icon name="lucide:wrench" class="h-4 w-4" />
          <span>{t.handbook.manuals.dev.label}</span>
        </a>
        <a
          href={locale === 'en' ? '/landing/community/' : '/zh/landing/community/'}
          class="hidden items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-foreground/70 transition hover:bg-muted hover:text-foreground sm:inline-flex"
        >
          <Icon name="lucide:messages-square" class="h-4 w-4" />
          <span>{t.communityHighlights.navLabel}</span>
        </a>
        <a
          href="https://github.com/PNGTRID/AnvilWiki"
          class="hidden items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-foreground/70 transition hover:bg-muted hover:text-foreground sm:inline-flex"
        >
          <Icon name="lucide:star" class="h-4 w-4" />
          <span>GitHub</span>
        </a>
        <a
          href="/"
          class="hidden items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-foreground/70 transition hover:bg-muted hover:text-foreground sm:inline-flex"
        >
          <Icon name="lucide:external-link" class="h-4 w-4" />
          <span>Demo</span>
        </a>
        <ThemeToggle />
      </div>
    </div>

    {/* Mobile full-width search bar — second header row, <sm only. The field
        pill in the row above collapses to a tiny easy-to-miss icon on phones
        (user feedback: 首页也要搜索功能), so mobile gets an unmistakable bar.
        Tapping it opens the same Pagefind dialog via data-open-search. Keep
        the pb in sync with the sticky offsets that assume a 104px header
        (h-14 + this row): CommunityHighlights chips use top-[6.5rem]. */}
    {search && (
      <div
        class:list={[
          'mx-auto pb-3 sm:hidden',
          wide
            ? 'max-w-[1600px] px-4 sm:px-6 lg:px-8 2xl:max-w-[1728px] 2xl:px-10'
            : 'max-w-7xl px-4',
        ]}
      >
        <button
          type="button"
          data-open-search
          class="flex h-9 w-full items-center gap-2 rounded-md border border-border bg-muted/40 px-3 text-sm text-muted-foreground transition hover:border-nav/40 hover:text-nav"
        >
          <Icon name="lucide:search" class="h-4 w-4 shrink-0" />
          <span class="truncate">{t.search.placeholder}</span>
        </button>
      </div>
    )}
  </header>

  <main>
    <slot />
  </main>

  {/* Simplified footer */}
  <footer class="border-t border-border">
    <div
      class:list={[
        'mx-auto py-10',
        wide
          ? 'max-w-[1600px] px-4 sm:px-6 lg:px-8 2xl:max-w-[1728px] 2xl:px-10'
          : 'max-w-7xl px-4',
      ]}
    >
      <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:text-left">
        <div class="flex items-center gap-2">
          <Icon name="lucide:hammer" class="h-5 w-5 text-nav" />
          <div>
            <p class="font-bold text-foreground">AnvilWiki</p>
            <p class="text-xs text-muted-foreground">{t.footer.tagline}</p>
          </div>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <a
            href={locale === 'en' ? '/landing/community/' : '/zh/landing/community/'}
            class="text-foreground/70 transition hover:text-foreground"
          >
            {t.communityHighlights.navLabel}
          </a>
          <a
            href="https://github.com/PNGTRID/AnvilWiki"
            class="text-foreground/70 transition hover:text-foreground"
          >
            GitHub
          </a>
          <a href="/" class="text-foreground/70 transition hover:text-foreground">Demo</a>
          <a
            href="https://github.com/PNGTRID/AnvilWiki/blob/main/LICENSE"
            class="text-foreground/70 transition hover:text-foreground"
          >
            {t.footer.license}
          </a>
        </div>
      </div>
      <p class="mt-6 text-center text-xs text-muted-foreground sm:text-left">
        {t.footer.madeWith} · © 2026 AnvilWiki Contributors
      </p>
      <p class="mt-1 text-center text-xs text-muted-foreground sm:text-left">
        {t.footer.author} · <a href="https://github.com/PNGTRID" class="transition hover:text-nav">GitHub @PNGTRID</a>
      </p>
      <p class="mt-1 text-center text-xs text-muted-foreground sm:text-left">
        {t.footer.creditsLabel}
        {t.footer.credits.map((credit, i) => (
          <>
            {i > 0 && <span> · </span>}
            <a href={credit.href} class="transition hover:text-nav" rel="noopener">{credit.name}</a>
            <span> — {credit.note}</span>
          </>
        ))}
      </p>
    </div>
  </footer>
</BaseLayout>
