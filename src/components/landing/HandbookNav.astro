---
/**
 * HandbookNav — the left-hand manual tree on chapter pages: every chapter of
 * both manuals, grouped, with the current chapter highlighted. Sticky sidebar
 * on lg+ screens; collapsible <details> below (same dual pattern as the wiki
 * TableOfContents). Pure HTML/CSS, zero JS.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';
import {
  handbookPath,
  shortTitle,
  parseHandbookId,
  sortChapters,
  type HandbookEntry,
  type HandbookLocale,
  type HandbookManual,
} from '~/lib/handbook';

interface Props {
  chapters: HandbookEntry[];
  currentId: string;
  locale: HandbookLocale;
  t: LandingContent;
}
const { chapters, currentId, locale, t } = Astro.props;

const manuals: HandbookManual[] = ['learn', 'dev'];
const manualIcons: Record<HandbookManual, string> = {
  learn: 'lucide:graduation-cap',
  dev: 'lucide:wrench',
};

const groups = manuals.map((manual) => ({
  manual,
  chapters: sortChapters(chapters.filter((c) => c.data.manual === manual)),
}));
---

<nav aria-label={t.handbook.manualsLabel} class="not-prose">
  {/* Desktop (lg+): sticky tree */}
  <div class="hidden lg:sticky lg:top-20 lg:block">
    <div class="rounded-lg border border-border bg-card p-4">
      <a
        href={handbookPath(locale, '', true)}
        class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground transition hover:text-nav"
      >
        <Icon name="lucide:book-open" class="h-3.5 w-3.5" />
        {t.handbook.backToHub}
      </a>
      {groups.map(
        (group) =>
          group.chapters.length > 0 && (
            <div class="mt-4">
              <a
                href={handbookPath(locale, group.manual)}
                class="flex items-center gap-1.5 text-xs font-semibold text-foreground/80 transition hover:text-nav"
              >
                <Icon name={manualIcons[group.manual]} class="h-3.5 w-3.5 text-nav" />
                {t.handbook.manuals[group.manual].label}
              </a>
              <ul class="mt-2 space-y-1 text-sm">
                {group.chapters.map((c) => {
                  const slug = parseHandbookId(c.id)?.slug ?? '';
                  const isCurrent = c.id === currentId;
                  return (
                    <li>
                      <a
                        href={handbookPath(locale, slug)}
                        aria-current={isCurrent ? 'page' : undefined}
                        class:list={[
                          'flex gap-1.5 rounded px-1.5 py-1 leading-snug transition',
                          isCurrent
                            ? 'bg-nav/10 font-semibold text-nav'
                            : 'text-muted-foreground hover:text-nav hover:underline',
                        ]}
                      >
                        <span class="tabular-nums opacity-60">{c.data.order}.</span>
                        <span>{shortTitle(c.data.title, c.data.shortTitle)}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ),
      )}
    </div>
  </div>

  {/* Mobile / tablet (<lg): collapsible */}
  <details class="rounded-lg border border-border bg-card p-3 lg:hidden">
    <summary class="flex cursor-pointer items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
      <Icon name="lucide:list-tree" class="h-3.5 w-3.5" />
      {t.handbook.manualsLabel}
    </summary>
    <div class="mt-3 space-y-3">
      {groups.map(
        (group) =>
          group.chapters.length > 0 && (
            <div>
              <a
                href={handbookPath(locale, group.manual)}
                class="flex items-center gap-1.5 text-xs font-semibold text-foreground/80 transition hover:text-nav"
              >
                <Icon name={manualIcons[group.manual]} class="h-3.5 w-3.5 text-nav" />
                {t.handbook.manuals[group.manual].label}
              </a>
              <ul class="mt-1.5 space-y-1 text-sm">
                {group.chapters.map((c) => {
                  const slug = parseHandbookId(c.id)?.slug ?? '';
                  const isCurrent = c.id === currentId;
                  return (
                    <li>
                      <a
                        href={handbookPath(locale, slug)}
                        aria-current={isCurrent ? 'page' : undefined}
                        class:list={[
                          'flex gap-1.5 rounded px-1.5 py-1 leading-snug transition',
                          isCurrent
                            ? 'bg-nav/10 font-semibold text-nav'
                            : 'text-muted-foreground hover:text-nav hover:underline',
                        ]}
                      >
                        <span class="tabular-nums opacity-60">{c.data.order}.</span>
                        <span>{shortTitle(c.data.title, c.data.shortTitle)}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ),
      )}
    </div>
  </details>
</nav>
