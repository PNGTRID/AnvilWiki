---
/**
 * DealsOverview — the coupon-hub variant of the codes list page: aggregates
 * every merchant page's `codes` frontmatter into a scannable "active codes,
 * one click away" board, grouped per merchant with its article linked. Chosen
 * by the build-time siteType signal (site.siteType === 'coupon-hub') in
 * ListPage — the game-wiki default keeps the plain article-card grid
 * byte-for-byte. Zero new JS: reuses CodeBlock's copy button and the
 * shared.codesTable labels; no new i18n keys.
 */
import { Icon } from 'astro-icon/components';
import CodeBlock from './CodeBlock.astro';

interface CodeItem {
  code: string;
  reward?: string;
  status: 'active' | 'expired';
  expiryDate?: string;
  source?: string;
}

interface Merchant {
  title: string;
  href: string;
  codes: CodeItem[];
}

interface Props {
  merchants: Merchant[];
  /** Locale strings from shared.codesTable (active/expired/reward/expires/code). */
  labels: Record<string, string>;
  /** "Copied!" feedback text passed through to CodeBlock. */
  copiedText?: string;
  /**
   * Cap active codes shown per merchant — the homepage strip passes a small
   * number to stay above the fold; the codes list page omits it (show all).
   * The full list always lives one click away on the merchant's own page.
   */
  perMerchantLimit?: number;
}

const { merchants, labels, copiedText, perMerchantLimit } = Astro.props;
if (merchants.length === 0) return null;

const t = (key: string, fallback: string) => labels[key] ?? fallback;
const codeLabel = (c: CodeItem) =>
  [c.reward, c.expiryDate ? `${t('expires', 'Expires')}: ${c.expiryDate}` : undefined]
    .filter(Boolean)
    .join(' · ');
---

<div class="space-y-10">
  {
    merchants.map((m) => {
      const active = m.codes.filter((c) => c.status === 'active');
      const expired = m.codes.filter((c) => c.status === 'expired');
      return (
        <section class="not-prose" aria-label={m.title}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-xl font-bold text-foreground">
              <a href={m.href} class="transition hover:text-nav">
                {m.title}
              </a>
            </h2>
            <span class="inline-flex items-center gap-2 text-xs text-muted-foreground">
              <span class="inline-flex items-center gap-1">
                <Icon name="lucide:circle-check" class="h-3.5 w-3.5 text-nav" />
                {active.length} {t('active', 'Active')}
              </span>
              <span class="inline-flex items-center gap-1">
                <Icon name="lucide:circle-x" class="h-3.5 w-3.5" />
                {expired.length} {t('expired', 'Expired')}
              </span>
            </span>
          </div>
          {active.length > 0 && (
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              {(perMerchantLimit ? active.slice(0, perMerchantLimit) : active).map((c) => (
                <CodeBlock code={c.code} label={codeLabel(c) || undefined} copiedText={copiedText} />
              ))}
            </div>
          )}
        </section>
      );
    })
  }
</div>
