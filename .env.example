# ─── Site configuration ──────────────────────────────────────────────
# Absolute site URL (no trailing slash). Used for sitemap, og:image, robots.
SITE_URL=https://your-domain.wiki

# ─── Adsterra ad slots (optional) ────────────────────────────────────
# Leave empty to disable ads. Each key gates its corresponding ad component.
# Get keys from https://publishers.adsterra.com/ after registering your site.
PUBLIC_AD_MOBILE_320X50=
PUBLIC_AD_SIDEBAR_160X300=
PUBLIC_AD_SIDEBAR_160X600=
PUBLIC_AD_BANNER_728X90=
PUBLIC_AD_BANNER_300X250=
PUBLIC_AD_BANNER_468X60=
PUBLIC_AD_NATIVE_BANNER=

# Google AdSense (optional, slow approval — register early)
PUBLIC_GOOGLE_ADSENSE_ID=

# ─── Analytics (optional) ────────────────────────────────────────────
PUBLIC_GA_ID=

# ─── Google Search Console verification (optional) ──────────────────
PUBLIC_GSC_VERIFICATION=
