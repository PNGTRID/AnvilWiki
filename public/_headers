# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
#
# Security + Lighthouse Best Practices headers applied to all responses.
#
# HSTS is set here (not in zone settings) because pages.dev subdomains cannot
# get zone-level HSTS — _headers is the only vehicle. includeSubDomains is
# deliberately omitted: the apex domain may host sibling subdomains this site
# does not control, and an HSTS pin (unlike a header) cannot be rolled back
# quickly once browsers cache the max-age.
# No Content-Security-Policy either: AdSense scripts + giscus/YouTube iframes
# need per-fork allowlists, and one new vendor would silently break every
# page for template users — the stable subset below never fights monetization.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed build assets (CSS/JS/fonts) never change — cache immutably for a year.
# Returning visitors get instant repeat loads (helps LCP on revisit).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static images change only on deploy and have no content hash — one day
# plus stale-while-revalidate keeps repeat views fast without serving
# outdated screenshots after an update.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Pagefind search index + UI are rebuilt per deploy, and the UI bundle is
# CODE that must reach (old) webviews immediately after a fix — a day-long
# cache here kept serving a broken bundle for up to 24h after a deploy.
# Revalidate every time; etag 304s keep repeat visits cheap.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate

# Deployment synchronization marker used by the optional IndexNow workflow.
# Never cache it: the workflow must observe the exact commit that Pages serves.
/.well-known/anvilwiki-deploy.txt
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Ad unit pages (public/ads/*.html) exist only to be iframed by this same
# site — restrict who may frame them. Scoped to /ads/* on purpose: a
# site-wide CSP stays out (see the note at the top), this only fences the
# unit pages themselves. Same-origin framing is unaffected.
/ads/*
  Content-Security-Policy: frame-ancestors 'self'
